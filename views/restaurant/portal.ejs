<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title><%= title || 'Restaurant Partner Portal · Happy Deliveries' %></title>
  <link rel="shortcut icon" href="https://res.cloudinary.com/dpdira4rd/image/upload/v1794689689/logo-square_gmpkuq.png" type="image/x-icon">
  <link href="https://fonts.googleapis.com/css2?family=Inter:wght@400;500;600;700;800&display=swap" rel="stylesheet">
  <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.4.0/css/all.min.css">
  <link rel="stylesheet" href="/css/main.css">
  <link rel="stylesheet" href="/css/menu-editor.css">
  <link rel="stylesheet" href="/css/order-details.css">
  <style>
    :root {
      --background: 0 0% 100%;
      --foreground: 222.2 84% 4.9%;
      --card: 0 0% 100%;
      --muted: 210 40% 96.1%;
      --muted-foreground: 215.4 16.3% 46.9%;
      --border: 214.3 31.8% 91.4%;
      --input: 214.3 31.8% 91.4%;
      --primary: 221.2 83.2% 53.3%;
      --primary-foreground: 210 40% 98%;
      --destructive: 0 84.2% 60.2%;
      --radius: 0.65rem;
      --sidebar-width: 16rem;
    }
    * { box-sizing: border-box; margin: 0; padding: 0; border-color: hsl(var(--border)); }
    body {
      font-family: 'Inter', -apple-system, BlinkMacSystemFont, sans-serif;
      background: #f8fafc;
      color: hsl(var(--foreground));
      line-height: 1.5;
    }
    .app-container { display: flex; min-height: 100vh; }

    .sidebar {
      width: var(--sidebar-width); height: 100vh; position: fixed; left: 0; top: 0;
      background: #fff; border-right: 1px solid hsl(var(--border));
      display: flex; flex-direction: column; z-index: 60;
    }
    .sidebar-header {
      padding: 1.25rem 1.35rem; display: flex; align-items: center; gap: 0.65rem;
      border-bottom: 1px solid hsl(var(--border));
    }
    .sidebar-logo {
      width: 2.2rem; height: 2.2rem; border-radius: 8px;
      background: url('https://res.cloudinary.com/dpdira4rd/image/upload/v1794689123/logo-square_pzavip.png') center/cover no-repeat;
    }
    .sidebar-title { font-size: 1rem; font-weight: 700; }
    .sidebar-sub { font-size: 0.72rem; color: hsl(var(--muted-foreground)); }
    .sidebar-content { flex: 1; padding: 0.75rem; overflow-y: auto; }
    .sidebar-menu { list-style: none; display: flex; flex-direction: column; gap: 0.3rem; }
    .sidebar-menu-item {
      display: flex; align-items: center; justify-content: space-between; gap: 0.6rem;
      padding: 0.6rem 0.85rem; border-radius: 8px; font-size: 0.875rem; font-weight: 500;
      color: hsl(var(--foreground)); text-decoration: none; cursor: pointer; border: none; background: transparent; width: 100%; text-align: left;
      transition: background 0.15s;
    }
    .sidebar-menu-item:hover { background: hsl(var(--muted)); }
    .sidebar-menu-item.active { background: #eff6ff; color: #1d4ed8; font-weight: 600; }
    .sidebar-menu-left { display: flex; align-items: center; gap: 0.65rem; }
    .sidebar-footer { padding: 1rem; border-top: 1px solid hsl(var(--border)); }
    .sidebar-user { display: flex; align-items: center; gap: 0.7rem; }
    .avatar {
      width: 2.1rem; height: 2.1rem; border-radius: 50%; background: #eff6ff; color: #1d4ed8;
      display: flex; align-items: center; justify-content: center; font-weight: 700; font-size: 0.8rem;
      flex-shrink: 0; overflow: hidden;
    }
    .avatar img { width: 100%; height: 100%; object-fit: cover; }

    .main-content { flex: 1; margin-left: var(--sidebar-width); min-width: 0; }
    @media (max-width: 820px) {
      .sidebar { transform: translateX(-100%); transition: transform 0.2s; }
      .sidebar.open { transform: translateX(0); }
      .main-content { margin-left: 0; }
    }

    .topbar {
      background: #fff; border-bottom: 1px solid hsl(var(--border)); padding: 0.9rem 1.75rem;
      display: flex; align-items: center; justify-content: space-between; gap: 1rem; flex-wrap: wrap;
      position: sticky; top: 0; z-index: 40;
    }
    .topbar-left { display: flex; align-items: center; gap: 0.85rem; flex-wrap: wrap; }
    .topbar-right { display: flex; align-items: center; gap: 0.75rem; flex-wrap: wrap; }
    .live-pill {
      display: inline-flex; align-items: center; gap: 0.45rem; padding: 0.35rem 0.75rem;
      border-radius: 999px; font-size: 0.76rem; font-weight: 600;
      border: 1px solid hsl(var(--border)); background: #f8fafc;
    }
    .dot-green { width: 8px; height: 8px; border-radius: 50%; background: #16a34a; display: inline-block; }

    .btn {
      display: inline-flex; align-items: center; justify-content: center; gap: 0.45rem;
      padding: 0.5rem 0.95rem; border-radius: var(--radius); font-size: 0.85rem;
      font-weight: 600; cursor: pointer; border: none; text-decoration: none;
      transition: all 0.15s; white-space: nowrap;
    }
    .btn-primary { background: hsl(var(--primary)); color: #fff; }
    .btn-primary:hover { opacity: 0.92; }
    .btn-success { background: #16a34a; color: #fff; }
    .btn-success:hover { background: #15803d; }
    .btn-danger { background: #dc2626; color: #fff; }
    .btn-danger:hover { background: #b91c1c; }
    .btn-outline { background: #fff; border: 1px solid hsl(var(--input)); color: hsl(var(--foreground)); }
    .btn-outline:hover { background: hsl(var(--muted)); }
    .btn-ghost { background: transparent; color: hsl(var(--foreground)); }
    .btn-ghost:hover { background: hsl(var(--muted)); }
    .btn-sm { padding: 0.35rem 0.7rem; font-size: 0.76rem; }

    .page-container { padding: 1.5rem 1.75rem; display: flex; flex-direction: column; gap: 1.35rem; }
    .section-panel { display: none; flex-direction: column; gap: 1.35rem; }
    .section-panel.active { display: flex; }

    .grid-4 { display: grid; grid-template-columns: repeat(4, 1fr); gap: 1rem; }
    .grid-2 { display: grid; grid-template-columns: repeat(2, 1fr); gap: 1rem; }
    .grid-3 { display: grid; grid-template-columns: repeat(3, 1fr); gap: 1rem; }
    @media (max-width: 1100px) { .grid-4 { grid-template-columns: repeat(2, 1fr); } .grid-3 { grid-template-columns: repeat(2, 1fr); } }
    @media (max-width: 640px) { .grid-4, .grid-2, .grid-3 { grid-template-columns: 1fr; } }

    .card { background: #fff; border: 1px solid hsl(var(--border)); border-radius: var(--radius); overflow: hidden; }
    .card-header { padding: 1.1rem 1.35rem; border-bottom: 1px solid hsl(var(--border)); display: flex; align-items: center; justify-content: space-between; gap: 0.75rem; flex-wrap: wrap; }
    .card-title { font-size: 1rem; font-weight: 700; }
    .card-body { padding: 1.25rem 1.35rem; }

    .stat-card { padding: 1.15rem 1.25rem; }
    .stat-label { font-size: 0.78rem; color: hsl(var(--muted-foreground)); font-weight: 600; }
    .stat-value { font-size: 1.65rem; font-weight: 800; margin-top: 0.25rem; }
    .stat-sub { font-size: 0.75rem; color: hsl(var(--muted-foreground)); margin-top: 0.2rem; }

    .badge {
      display: inline-flex; align-items: center; gap: 0.3rem;
      padding: 0.2rem 0.6rem; border-radius: 999px; font-size: 0.72rem; font-weight: 600;
    }
    .badge-yellow { background: #fef3c7; color: #92400e; }
    .badge-green  { background: #dcfce7; color: #166534; }
    .badge-red    { background: #fee2e2; color: #991b1b; }
    .badge-blue   { background: #dbeafe; color: #1e40af; }
    .badge-purple { background: #f3e8ff; color: #6b21a8; }
    .badge-gray   { background: #f1f5f9; color: #334155; }

    .table-wrap { overflow-x: auto; }
    table { width: 100%; border-collapse: collapse; text-align: left; font-size: 0.86rem; }
    th {
      padding: 0.8rem 1rem; background: #f8fafc; font-size: 0.73rem; font-weight: 700;
      text-transform: uppercase; letter-spacing: 0.04em; color: hsl(var(--muted-foreground));
      border-bottom: 1px solid hsl(var(--border)); white-space: nowrap;
    }
    td { padding: 0.85rem 1rem; border-bottom: 1px solid hsl(var(--border)); vertical-align: middle; }
    tr:hover td { background: #f8fafc; }

    .form-group { display: flex; flex-direction: column; gap: 0.35rem; margin-bottom: 0.85rem; }
    .form-label { font-size: 0.8rem; font-weight: 600; }
    .form-input, .form-select, textarea.form-input {
      width: 100%; padding: 0.55rem 0.75rem; border: 1px solid hsl(var(--input));
      border-radius: var(--radius); font-size: 0.875rem; font-family: inherit; outline: none;
      background: #fff;
    }
    .form-input:focus, .form-select:focus { border-color: hsl(var(--primary)); box-shadow: 0 0 0 2px rgba(37,99,235,0.14); }

    .menu-items-grid { display: grid; grid-template-columns: repeat(auto-fill, minmax(260px, 1fr)); gap: 1rem; }
    .dish-card {
      border: 1px solid hsl(var(--border)); border-radius: var(--radius); overflow: hidden; background: #fff;
      display: flex; flex-direction: column;
    }
    .dish-img { height: 145px; background: #f1f5f9; position: relative; overflow: hidden; display: flex; align-items: center; justify-content: center; color: #94a3b8; }
    .dish-img img { width: 100%; height: 100%; object-fit: cover; }
    .dish-body { padding: 0.9rem; flex: 1; display: flex; flex-direction: column; gap: 0.45rem; }

    .modal-backdrop {
      position: fixed; inset: 0; background: rgba(15,23,42,0.55); backdrop-filter: blur(2px);
      display: none; align-items: center; justify-content: center; z-index: 120; padding: 1rem;
    }
    .modal-backdrop.open { display: flex; }
    .modal-box {
      background: #fff; border-radius: 12px; width: 100%; max-width: 820px; max-height: 90vh;
      display: flex; flex-direction: column; overflow: hidden; box-shadow: 0 25px 50px rgba(0,0,0,0.25);
    }
    .modal-header { padding: 1.15rem 1.35rem; border-bottom: 1px solid hsl(var(--border)); display: flex; justify-content: space-between; align-items: center; }
    .modal-body { padding: 1.25rem 1.35rem; overflow-y: auto; display: flex; flex-direction: column; gap: 1rem; }
    .modal-footer { padding: 0.95rem 1.35rem; border-top: 1px solid hsl(var(--border)); display: flex; justify-content: flex-end; gap: 0.6rem; background: #f8fafc; }

    .driver-card {
      border: 1px solid #bfdbfe; background: #eff6ff; border-radius: 10px; padding: 0.95rem 1.1rem;
      display: grid; grid-template-columns: repeat(3, 1fr); gap: 0.65rem;
    }
    @media (max-width: 640px) { .driver-card { grid-template-columns: 1fr; } }

    .toast-container { position: fixed; bottom: 1.5rem; right: 1.5rem; z-index: 200; display: flex; flex-direction: column; gap: 0.5rem; max-width: 380px; }
    .toast {
      background: #0f172a; color: #fff; padding: 0.85rem 1.1rem; border-radius: 10px;
      font-size: 0.84rem; box-shadow: 0 10px 25px rgba(0,0,0,0.2);
    }
    .settings-tabs { display: flex; gap: 0.5rem; flex-wrap: wrap; border-bottom: 1px solid hsl(var(--border)); padding-bottom: 0.75rem; margin-bottom: 1rem; }
    .settings-tab-btn {
      padding: 0.45rem 0.9rem; border-radius: 8px; border: 1px solid hsl(var(--border));
      background: #fff; font-size: 0.82rem; font-weight: 600; cursor: pointer;
    }
    .settings-tab-btn.active { background: hsl(var(--primary)); color: #fff; border-color: hsl(var(--primary)); }
    .settings-pane { display: none; }
    .settings-pane.active { display: block; }

    /* Ringing Incoming Order Banner & Topbar Sound Toggle */
    .ring-toggle-btn {
      display: inline-flex; align-items: center; gap: 0.4rem;
      padding: 0.4rem 0.85rem; border-radius: 999px; font-size: 0.78rem; font-weight: 700;
      border: 1px solid #cbd5e1; background: #fff; color: #334155; cursor: pointer;
    }
    .ring-toggle-btn.enabled { background: #ecfdf5; border-color: #6ee7b7; color: #065f46; }
    .ring-toggle-btn.muted { background: #fef2f2; border-color: #fecaca; color: #991b1b; }

    .incoming-ring-banner {
      display: none; align-items: center; justify-content: space-between; gap: 1rem; flex-wrap: wrap;
      background: linear-gradient(90deg, #b91c1c, #dc2626);
      color: #fff; padding: 0.95rem 1.25rem; border-radius: 12px;
      box-shadow: 0 10px 25px rgba(185, 28, 28, 0.28);
      animation: ringPulse 1.1s ease-in-out infinite alternate;
    }
    .incoming-ring-banner.active { display: flex; }
    @keyframes ringPulse {
      from { transform: scale(1); box-shadow: 0 8px 20px rgba(185, 28, 28, 0.28); }
      to   { transform: scale(1.006); box-shadow: 0 12px 30px rgba(220, 38, 38, 0.45); }
    }
    .driver-mini-avatar {
      width: 34px; height: 34px; border-radius: 50%; object-fit: cover;
      border: 2px solid #bfdbfe; background: #fff; flex-shrink: 0;
    }
    .driver-mini-initials {
      width: 34px; height: 34px; border-radius: 50%; background: #dbeafe; color: #1e3a8a;
      display: inline-flex; align-items: center; justify-content: center;
      font-weight: 800; font-size: 0.75rem; flex-shrink: 0;
    }
  </style>
</head>
<body>
<div class="app-container">
  <aside class="sidebar" id="sidebar">
    <div class="sidebar-header">
      <div class="sidebar-logo"></div>
      <div>
        <div class="sidebar-title">Happy Deliveries</div>
        <div class="sidebar-sub">Restaurant Partner</div>
      </div>
    </div>
    <nav class="sidebar-content">
      <ul class="sidebar-menu">
        <li>
          <button class="sidebar-menu-item <%= activeSection === 'overview' ? 'active' : '' %>" data-nav="overview" onclick="switchSection('overview', '/restaurant/dashboard')">
            <span class="sidebar-menu-left">
              <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><rect width="7" height="9" x="3" y="3" rx="1"/><rect width="7" height="5" x="14" y="3" rx="1"/><rect width="7" height="9" x="14" y="12" rx="1"/><rect width="7" height="5" x="3" y="16" rx="1"/></svg>
              <span>Dashboard</span>
            </span>
          </button>
        </li>
        <li>
          <button class="sidebar-menu-item <%= activeSection === 'kitchen' ? 'active' : '' %>" data-nav="kitchen" onclick="switchSection('kitchen', '/restaurant/kitchen')">
            <span class="sidebar-menu-left">
              <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M6 13.87A4 4 0 0 1 7.41 6a5.11 5.11 0 0 1 1.05-1.54 5 5 0 0 1 7.08 0A5.11 5.11 0 0 1 16.59 6 4 4 0 0 1 18 13.87V21H6Z"/><line x1="6" x2="18" y1="17" y2="17"/></svg>
              <span>Kitchen Prep</span>
            </span>
            <span class="badge badge-green" id="sidebarKitchenBadge" style="display:none;">0</span>
          </button>
        </li>
        <li>
          <button class="sidebar-menu-item <%= activeSection === 'orders' ? 'active' : '' %>" data-nav="orders" onclick="switchSection('orders', '/restaurant/orders')">
            <span class="sidebar-menu-left">
              <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M13 16H8"/><path d="M14 8H8"/><path d="M16 12H8"/><path d="M4 3h16v18l-2-1-2 1-2-1-2 1-2-1-2 1-2-1-2 1Z"/></svg>
              <span>Orders & Drivers</span>
            </span>
            <span class="badge badge-yellow" id="sidebarPendingBadge" style="display:none;">0</span>
          </button>
        </li>
        <li>
          <button class="sidebar-menu-item <%= activeSection === 'menus' ? 'active' : '' %>" data-nav="menus" onclick="switchSection('menus', '/restaurant/menus')">
            <span class="sidebar-menu-left">
              <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="m16 2-2.3 2.3a3 3 0 0 0 0 4.2l1.8 1.8a3 3 0 0 0 4.2 0L22 8"/><path d="M15 15 3.3 3.3a4.2 4.2 0 0 0 0 6l7.3 7.3c.7.7 2 .7 2.8 0L15 15Zm0 0 7 7"/></svg>
              <span>Menus & Dishes</span>
            </span>
          </button>
        </li>
        <li>
          <button class="sidebar-menu-item <%= activeSection === 'settings' ? 'active' : '' %>" data-nav="settings" onclick="switchSection('settings', '/restaurant/settings')">
            <span class="sidebar-menu-left">
              <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M15 21v-5a1 1 0 0 0-1-1h-4a1 1 0 0 0-1 1v5"/><path d="M4 10.95V19a2 2 0 0 0 2 2h12a2 2 0 0 0 2-2v-8.05"/></svg>
              <span>Store Info & Settings</span>
            </span>
          </button>
        </li>
      </ul>
    </nav>
    <div class="sidebar-footer">
      <div class="sidebar-user">
        <div class="avatar">
          <% if (restaurant.logo_url) { %>
            <img src="<%= restaurant.logo_url %>" alt="<%= restaurant.name %>" onerror="this.remove()">
          <% } else { %>
            <%= (partner.first_name || 'R')[0] %>
          <% } %>
        </div>
        <div style="min-width:0;">
          <div style="font-size:0.84rem;font-weight:700;white-space:nowrap;overflow:hidden;text-overflow:ellipsis;"><%= restaurant.name %></div>
          <div style="font-size:0.74rem;color:hsl(var(--muted-foreground));"><%= partner.first_name %> <%= partner.last_name %></div>
        </div>
      </div>
    </div>
  </aside>

  <main class="main-content">
    <header class="topbar">
      <div class="topbar-left">
        <button class="btn btn-outline btn-sm" onclick="document.getElementById('sidebar').classList.toggle('open')" style="display:none;" id="mobileMenuBtn">☰ Menu</button>
        <% if (restaurants.length > 1) { %>
          <select class="form-select" style="width:auto;font-weight:600;" onchange="changeStore(this.value)">
            <% restaurants.forEach((r) => { %>
              <option value="<%= r.id %>" <%= r.id === restaurant.id ? 'selected' : '' %>><%= r.name %></option>
            <% }) %>
          </select>
        <% } else { %>
          <strong style="font-size:1rem;"><%= restaurant.name %></strong>
        <% } %>

        <button class="btn btn-sm <%= restaurant.is_accepting_orders ? 'btn-success' : 'btn-outline' %>" id="acceptingOrdersBtn" onclick="toggleAcceptingOrders()">
          <%= restaurant.is_accepting_orders ? '● Accepting Orders' : '○ Orders Paused' %>
        </button>

        <span class="badge <%= restaurant.is_within_hours === false ? 'badge-yellow' : 'badge-gray' %>" id="scheduleHoursBadge" title="Customers can only order within opening hours">
          🕒 <%= restaurant.is_within_hours === false ? 'Outside Hours' : 'Hours Open' %> (<%= restaurant.opening_hours_display || '08:00 - 21:00' %>)
        </span>

        <span class="live-pill">
          <span class="dot-green"></span>
          <span id="socketStateText">Live Updates Active</span>
        </span>
        <button type="button" class="ring-toggle-btn" id="ringAlertToggleBtn" onclick="toggleRingAlerts()" title="Tap to enable continuous phone ring alert for incoming orders & keep screen awake">
          🔔 Enable Ring Sound
        </button>
        <% if (supportContact && supportContact.support_phone) { %>
          <a href="tel:<%= supportContact.support_phone %>" class="btn btn-outline btn-sm" style="background:#fffbeb;border-color:#fcd34d;color:#92400e;font-weight:700;" title="Call Happy Dispatch Support if driver is delayed">
            🛡️ Happy Dispatch: <%= supportContact.support_phone %>
          </a>
        <% } %>
      </div>
      <div class="topbar-right">
        <a href="/restaurant/logout" class="btn btn-outline btn-sm">Log out</a>
      </div>
    </header>

    <div class="page-container">
      <div class="incoming-ring-banner" id="incomingOrderRingBanner">
        <div style="display:flex;align-items:center;gap:0.75rem;">
          <span style="font-size:1.45rem;">📞</span>
          <div>
            <div style="font-weight:800;font-size:1rem;" id="incomingRingTitle">NEW ORDER WAITING FOR APPROVAL!</div>
            <div style="font-size:0.82rem;opacity:0.92;" id="incomingRingSub">Accept or reject the incoming order to stop the kitchen ringtone.</div>
          </div>
        </div>
        <div style="display:flex;gap:0.5rem;flex-wrap:wrap;">
          <button type="button" class="btn btn-sm" style="background:#fff;color:#991b1b;font-weight:800;" onclick="switchSection('kitchen', '/restaurant/kitchen'); silenceOrderRinging();">View & Accept Order</button>
          <button type="button" class="btn btn-sm" style="background:rgba(255,255,255,0.2);color:#fff;border:1px solid rgba(255,255,255,0.4);" onclick="silenceOrderRinging()">Silence Ring</button>
        </div>
      </div>
      <!-- ════════════ SECTION 1: OVERVIEW ════════════ -->
      <section class="section-panel <%= activeSection === 'overview' ? 'active' : '' %>" id="sec-overview">
        <div style="display:flex;justify-content:space-between;align-items:center;flex-wrap:wrap;gap:1rem;">
          <div>
            <h1 style="font-size:1.65rem;font-weight:800;">Welcome back, <%= partner.first_name || 'Partner' %></h1>
            <p style="font-size:0.86rem;color:hsl(var(--muted-foreground));">Live snapshot of orders, assigned delivery drivers, and menu items for <%= restaurant.name %>.</p>
          </div>
          <div style="display:flex;gap:0.5rem;">
            <button class="btn btn-outline" onclick="switchSection('menus', '/restaurant/menus')">+ Add Dish / Menu</button>
            <button class="btn btn-primary" onclick="refreshPortal()">Refresh</button>
          </div>
        </div>

        <div class="grid-4">
          <div class="card stat-card" style="border-left:4px solid #f59e0b;cursor:pointer;" onclick="switchSection('orders', '/restaurant/orders')">
            <div class="stat-label">Pending Approval</div>
            <div class="stat-value" id="ovPendingOrders" style="color:#d97706;">0</div>
            <div class="stat-sub">Tap Accept so customers can pay</div>
          </div>
          <div class="card stat-card" style="border-left:4px solid #2563eb;">
            <div class="stat-label">Active Orders</div>
            <div class="stat-value" id="ovActiveOrders" style="color:#2563eb;">0</div>
            <div class="stat-sub">Preparing & out for delivery</div>
          </div>
          <div class="card stat-card" style="border-left:4px solid #16a34a;">
            <div class="stat-label">Today's Revenue</div>
            <div class="stat-value" id="ovTodayRevenue" style="color:#16a34a;">R0.00</div>
            <div class="stat-sub"><span id="ovTodayOrders">0</span> orders today</div>
          </div>
          <div class="card stat-card">
