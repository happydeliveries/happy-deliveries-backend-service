<%- include('../partials/menu-editor-modals') %>

<div class="toast-container" id="toastContainer"></div>

<script src="/socket.io/socket.io.js"></script>
<script src="/js/menu-editor.js"></script>
<script src="/js/order-details.js"></script>
<script>
  const RESTAURANT_ID = "<%= restaurant.id %>";
  const MANAGER_ID = "<%= manager.id %>";
  const RESTAURANT_IDS = <%- JSON.stringify(restaurants.map(r => r.id)) %>;
  const SUPPORT_PHONE = <%- JSON.stringify((supportContact && supportContact.support_phone) || '') %>;
  const SUPPORT_NAME = <%- JSON.stringify((supportContact && supportContact.support_name) || 'Happy Deliveries Dispatch') %>;
  let currentOrderIdOpen = null;
  let currentOrderPage = 1;
  let currentKitchenFilter = 'all';
  let kitchenOrdersCache = [];

  const STATUS_BADGE_MAP = {
    pending: 'badge-yellow',
    ordering_at_restaurant: 'badge-blue',
    accepted_by_driver: 'badge-purple',
    order_ready: 'badge-green',
    picked_up: 'badge-blue',
    on_the_way: 'badge-blue',
    arrived: 'badge-green',
    delivered: 'badge-green',
    cancelled: 'badge-red',
    no_drivers_available: 'badge-red',
    delivery_failed: 'badge-red',
  };

  function esc(val) {
    if (val === null || val === undefined) return '';
    return String(val).replace(/[&<>"']/g, (c) => ({ '&': '&amp;', '<': '&lt;', '>': '&gt;', '"': '&quot;', "'": '&#39;' }[c]));
  }

  function fmtMoney(n) { return parseFloat(n || 0).toFixed(2); }
  function fmtDateTime(d) {
    if (!d) return '—';
    return new Date(d).toLocaleString('en-ZA', { month: 'short', day: 'numeric', hour: '2-digit', minute: '2-digit' });
  }

  function fmtStatus(st, payStatus) {
    if (st === 'ordering_at_restaurant') {
      return payStatus === 'completed' ? 'Paid · Preparing' : 'Accepted · Awaiting Customer Payment';
    }
    const labels = {
      pending: 'Pending Approval',
      accepted_by_driver: 'Driver Assigned',
      order_ready: 'Ready for Pickup',
      picked_up: 'Picked Up by Driver',
      on_the_way: 'On the Way',
      arrived: 'Arrived at Customer',
      delivered: 'Delivered',
      cancelled: 'Cancelled',
      no_drivers_available: 'No Drivers Available',
      delivery_failed: 'Delivery Failed (Forfeited)',
    };
    return labels[st] || st;
  }

  let sharedAudioCtx = null;
  let ringSoundEnabled = localStorage.getItem('happy_ring_sound') !== 'muted';
  let ringLoopTimer = null;
  let ringSilencedManually = false;
  let currentPendingCount = 0;
  let screenWakeLock = null;

  function ensureAudioCtx() {
    const AudioCtor = window.AudioContext || window.webkitAudioContext;
    if (!AudioCtor) return null;
    if (!sharedAudioCtx) sharedAudioCtx = new AudioCtor();
    if (sharedAudioCtx.state === 'suspended') {
      sharedAudioCtx.resume().catch(() => {});
    }
    return sharedAudioCtx;
  }

  async function acquireScreenWakeLock() {
    try {
      if ('wakeLock' in navigator && !screenWakeLock) {
        screenWakeLock = await navigator.wakeLock.request('screen');
        screenWakeLock.addEventListener?.('release', () => { screenWakeLock = null; });
      }
    } catch (_) {}
  }

  function updateRingToggleButton() {
    const btn = document.getElementById('ringAlertToggleBtn');
    if (!btn) return;
    if (!ringSoundEnabled) {
      btn.className = 'ring-toggle-btn muted';
      btn.textContent = '🔕 Ring Muted';
      return;
    }
    const unlocked = sharedAudioCtx && sharedAudioCtx.state === 'running';
    btn.className = unlocked ? 'ring-toggle-btn enabled' : 'ring-toggle-btn';
    btn.textContent = unlocked ? '🔔 Ring Alert ON' : '🔔 Tap to Enable Ring';
  }

  function toggleRingAlerts() {
    const ctx = ensureAudioCtx();
    if (!ringSoundEnabled) {
      ringSoundEnabled = true;
      localStorage.setItem('happy_ring_sound', 'enabled');
      ringSilencedManually = false;
      acquireScreenWakeLock();
      playAlertTone();
      showToast('🔔 Order Ring Enabled', 'Incoming customer orders will ring aloud while this dashboard is open.');
    } else if (!ctx || ctx.state !== 'running') {
      acquireScreenWakeLock();
      playAlertTone();
      showToast('🔔 Ring Audio Unlocked', 'Kitchen ring alert & screen wake-lock are now active.');
    } else {
      ringSoundEnabled = false;
      localStorage.setItem('happy_ring_sound', 'muted');
      stopOrderRinging();
      showToast('🔕 Order Ring Muted', 'Visual alerts remain active.');
    }
    updateRingToggleButton();
  }

  function playAlertTone() {
    if (!ringSoundEnabled) return;
    try {
      navigator.vibrate?.([420, 140, 420]);
    } catch (_) {}
    try {
      const ctx = ensureAudioCtx();
      if (!ctx) return;
      // Classic phone ring pattern: two brisk dual-tone warbles separated by a short pause
      [0, 0.55].forEach((offset) => {
        [784, 987.77].forEach((freq) => {
          const osc = ctx.createOscillator();
          const gain = ctx.createGain();
          osc.type = 'triangle';
          osc.frequency.value = freq;
          gain.gain.setValueAtTime(0.001, ctx.currentTime + offset);
          gain.gain.exponentialRampToValueAtTime(0.28, ctx.currentTime + offset + 0.03);
          gain.gain.setValueAtTime(0.28, ctx.currentTime + offset + 0.34);
          gain.gain.exponentialRampToValueAtTime(0.001, ctx.currentTime + offset + 0.42);
          osc.connect(gain);
          gain.connect(ctx.destination);
          osc.start(ctx.currentTime + offset);
          osc.stop(ctx.currentTime + offset + 0.44);
        });
      });
      updateRingToggleButton();
    } catch (_) {}
  }

  function startOrderRinging(orderNumLabel) {
    const banner = document.getElementById('incomingOrderRingBanner');
    const titleEl = document.getElementById('incomingRingTitle');
    if (banner) banner.classList.add('active');
    if (titleEl && orderNumLabel) {
      titleEl.textContent = `NEW ORDER #${orderNumLabel} WAITING FOR APPROVAL!`;
    } else if (titleEl && currentPendingCount > 0) {
      titleEl.textContent = `${currentPendingCount} PENDING ORDER${currentPendingCount === 1 ? '' : 'S'} WAITING FOR APPROVAL!`;
    }
    if (ringSilencedManually || !ringSoundEnabled) return;
    playAlertTone();
    if (!ringLoopTimer) {
      ringLoopTimer = setInterval(() => {
        if (currentPendingCount <= 0 || ringSilencedManually || !ringSoundEnabled) {
          stopOrderRinging(false);
          return;
        }
        playAlertTone();
      }, 2600);
    }
  }

  function stopOrderRinging(hideBanner = true) {
    if (ringLoopTimer) {
      clearInterval(ringLoopTimer);
      ringLoopTimer = null;
    }
    if (hideBanner) {
      document.getElementById('incomingOrderRingBanner')?.classList.remove('active');
    }
  }

  function silenceOrderRinging() {
    ringSilencedManually = true;
    stopOrderRinging(true);
  }

  // Unlock Web Audio cleanly on the first tap/click anywhere on the dashboard
  document.addEventListener('pointerdown', () => {
    if (ringSoundEnabled) {
      ensureAudioCtx();
      acquireScreenWakeLock();
      updateRingToggleButton();
    }
  }, { passive: true });

  document.addEventListener('visibilitychange', () => {
    if (!document.hidden && ringSoundEnabled) {
      acquireScreenWakeLock();
    }
  });

  function showToast(title, subtitle) {
    const c = document.getElementById('toastContainer');
    const el = document.createElement('div');
    el.className = 'toast';
    el.innerHTML = `<div style="font-weight:700;">${esc(title)}</div>${subtitle ? `<div style="font-size:0.78rem;color:#cbd5e1;margin-top:2px;">${esc(subtitle)}</div>` : ''}`;
    c.appendChild(el);
    setTimeout(() => el.remove(), 5500);
  }

  function openModal(id) {
    const el = document.getElementById(id);
    if (el) { el.classList.add('open'); el.classList.add('active'); }
  }
  function closeModal(id) {
    const el = document.getElementById(id);
    if (el) { el.classList.remove('open'); el.classList.remove('active'); }
    document.body.style.overflow = '';
    if (id === 'orderDetailModal') currentOrderIdOpen = null;
  }

  function changeStore(id) {
    window.location.href = `${window.location.pathname}?restaurantId=${encodeURIComponent(id)}`;
  }

  function switchSection(section, urlPath) {
    document.querySelectorAll('.section-panel').forEach((p) => p.classList.remove('active'));
    document.getElementById('sec-' + section)?.classList.add('active');
    document.querySelectorAll('[data-nav]').forEach((b) => {
      b.classList.toggle('active', b.dataset.nav === section);
    });
    if (urlPath && window.history?.pushState) {
      window.history.pushState({}, '', `${urlPath}?restaurantId=${encodeURIComponent(RESTAURANT_ID)}`);
    }
    if (section === 'kitchen') loadKitchenOrders();
    if (section === 'orders') loadOrders(currentOrderPage);
    if (section === 'menus') loadMenus();
    if (section === 'settings') updateStoreMap();
  }

  function renderDriverAvatarHtml(imageUrl, name) {
    if (imageUrl) {
      const safe = esc(imageUrl);
      return `<a href="${safe}" target="_blank" rel="noopener noreferrer" title="View driver photo" style="flex-shrink:0;"><img src="${safe}" alt="${esc(name || 'Driver')}" class="driver-mini-avatar"></a>`;
    }
    const initials = esc(
      String(name || 'DR')
        .split(/\s+/)
        .filter(Boolean)
        .slice(0, 2)
        .map((p) => p.charAt(0).toUpperCase())
        .join('') || 'DR'
    );
    return `<span class="driver-mini-initials">${initials}</span>`;
  }

  function renderDriverSummaryCell(o) {
    const rescueInfo = typeof o.rescue_courier === 'string'
      ? (() => { try { return JSON.parse(o.rescue_courier); } catch { return null; } })()
      : o.rescue_courier;
    if (rescueInfo?.name) {
      return `
        <div>
          <div style="font-weight:600;color:#047857;">🛡️ ${esc(rescueInfo.name)}</div>
          <div style="font-size:0.74rem;color:#065f46;">${esc(rescueInfo.courier_type_label || 'Happy Dispatch Rescue')}</div>
          ${rescueInfo.phone ? `<div style="font-size:0.75rem;"><a href="tel:${esc(rescueInfo.phone)}" style="color:#047857;font-weight:600;">📞 ${esc(rescueInfo.phone)}</a></div>` : ''}
        </div>
      `;
    }
    if (o.driver_name) {
      const veh = [o.driver_vehicle_color, o.driver_vehicle_model || o.driver_vehicle_type].filter(Boolean).join(' ');
      return `
        <div style="display:flex;align-items:center;gap:8px;">
          ${renderDriverAvatarHtml(o.driver_image, o.driver_name)}
          <div>
            <div style="font-weight:600;color:#1e40af;">${esc(o.driver_name)}</div>
            ${o.reassigned_at ? `<div style="font-size:0.7rem;color:#2563eb;font-weight:700;">REASSIGNED DRIVER</div>` : ''}
            <div style="font-size:0.75rem;color:hsl(var(--muted-foreground));">${o.driver_phone ? `<a href="tel:${esc(o.driver_phone)}" style="color:#1d4ed8;">📞 ${esc(o.driver_phone)}</a>` : ''}</div>
            ${veh || o.driver_vehicle_plate ? `<div style="font-size:0.74rem;color:#475569;">${esc(veh)} ${o.driver_vehicle_plate ? '· <strong>' + esc(o.driver_vehicle_plate) + '</strong>' : ''}</div>` : ''}
          </div>
        </div>
      `;
    }
    if (o.status === 'pending') return '<span style="font-size:0.76rem;color:hsl(var(--muted-foreground));">Approve order first</span>';
    if (o.payment_status !== 'completed' && o.status === 'ordering_at_restaurant') return '<span style="font-size:0.76rem;color:hsl(var(--muted-foreground));">Waiting customer payment</span>';
    if (['cancelled', 'no_drivers_available', 'delivery_failed'].includes(o.status)) return '<span style="font-size:0.76rem;color:#991b1b;">Unassigned</span>';
    return `<span class="badge badge-gray">${o.reassigned_at ? '🔄 Finding new driver…' : 'Searching for driver...'}</span>${SUPPORT_PHONE ? `<div style="margin-top:4px;"><a href="tel:${esc(SUPPORT_PHONE)}" style="font-size:0.72rem;color:#92400e;font-weight:600;">📞 Call Happy</a></div>` : ''}`;
  }

  function renderOrderActionButtons(o) {
    const btns = [];
    if (o.status === 'pending') {
      btns.push(`<button class="btn btn-success btn-sm" onclick="acceptOrder('${o.id}', this)">Accept</button>`);
      btns.push(`<button class="btn btn-danger btn-sm" onclick="rejectOrder('${o.id}', this)">Reject</button>`);
    } else if ((o.status === 'ordering_at_restaurant' || o.status === 'accepted_by_driver') && o.payment_status === 'completed') {
      btns.push(`<button class="btn btn-primary btn-sm" onclick="updateOrderStatus('${o.id}', 'order_ready', this)">Mark Ready</button>`);
    }
    btns.push(`<button class="btn btn-outline btn-sm" onclick="openOrderModal('${o.id}')">Details</button>`);
    return `<div style="display:inline-flex;gap:0.35rem;flex-wrap:wrap;justify-content:flex-end;">${btns.join('')}</div>`;
  }

  function setKitchenFilter(filter, btn) {
    currentKitchenFilter = filter || 'all';
    document.querySelectorAll('#kitchenFilterBar .kitchen-pill').forEach((p) => {
      p.classList.toggle('active', p.dataset.kfilter === currentKitchenFilter);
    });
    renderKitchenTickets();
  }

  function getKitchenCategory(o) {
    if (o.status === 'pending') return 'pending';
    if (o.status === 'order_ready') return 'ready';
    if (o.payment_status === 'completed') return 'cook';
    return 'unpaid';
  }

  async function loadKitchenOrders() {
    try {
      const params = new URLSearchParams({
        restaurantId: RESTAURANT_ID,
        status: 'kitchen_active',
        limit: 50,
      });
      const res = await fetch('/restaurant/api/orders?' + params.toString());
      const data = await res.json();
      kitchenOrdersCache = Array.isArray(data.orders) ? data.orders : [];
      OrderDetails.rememberOrders(kitchenOrdersCache);
      renderKitchenTickets();
    } catch (err) {
      console.error('[loadKitchenOrders]', err);
    }
  }

  function renderKitchenTickets() {
    const counts = { all: kitchenOrdersCache.length, pending: 0, cook: 0, unpaid: 0, ready: 0 };
    kitchenOrdersCache.forEach((o) => {
      const cat = getKitchenCategory(o);
      if (counts[cat] !== undefined) counts[cat]++;
    });

    document.getElementById('kcAll').textContent = counts.all;
    document.getElementById('kcPending').textContent = counts.pending;
    document.getElementById('kcCook').textContent = counts.cook;
    document.getElementById('kcUnpaid').textContent = counts.unpaid;
    document.getElementById('kcReady').textContent = counts.ready;

    const grid = document.getElementById('kitchenTicketsGrid');
    const filtered = currentKitchenFilter === 'all'
      ? kitchenOrdersCache
      : kitchenOrdersCache.filter((o) => getKitchenCategory(o) === currentKitchenFilter);

    if (!filtered.length) {
      grid.innerHTML = `<div class="card card-body" style="grid-column:1/-1;text-align:center;padding:2.5rem;color:hsl(var(--muted-foreground));">No active kitchen tickets in this queue right now.</div>`;
      return;
    }

    grid.innerHTML = filtered.map((o) => {
      const cat = getKitchenCategory(o);
      let ticketClass = 'kt-cook';
      let bannerClass = 'kt-banner-cook';
      let bannerLabel = '✅ PAID · PREPARE NOW';

      if (cat === 'pending') {
        ticketClass = 'kt-pending';
        bannerClass = 'kt-banner-pending';
        bannerLabel = '⏳ NEEDS RESTAURANT APPROVAL';
      } else if (cat === 'unpaid') {
        ticketClass = 'kt-unpaid';
        bannerClass = 'kt-banner-unpaid';
        bannerLabel = '💳 ACCEPTED · WAITING CUSTOMER PAYMENT (HOLD PREP)';
      } else if (o.status === 'accepted_by_driver') {
        ticketClass = 'kt-driver';
        bannerClass = 'kt-banner-cook';
        bannerLabel = '🚗 PAID · DRIVER ASSIGNED — FINISH PREP';
      } else if (cat === 'ready') {
        ticketClass = 'kt-ready';
        bannerClass = 'kt-banner-ready';
        bannerLabel = '📦 READY FOR PICKUP';
      }

      const itemsHtml = OrderDetails.renderOrderItemsList(o.items || [], { kitchenMode: true });
      const oid = OrderDetails.safeId(o.id);

      return `
        <div class="kitchen-ticket ${ticketClass}">
          <div class="kitchen-ticket-head">
            <div>
              <div style="font-size:1.05rem;font-weight:800;">#${esc(o.order_number || oid.slice(0, 8).toUpperCase())}</div>
              <div style="font-size:0.78rem;color:hsl(var(--muted-foreground));">
                ${esc(o.customer_name || 'Customer')} ${o.customer_phone ? `· ${esc(o.customer_phone)}` : ''}
              </div>
            </div>
            <div style="text-align:right;">
              <div style="font-weight:800;font-size:0.86rem;color:hsl(var(--primary));">${esc(OrderDetails.relativeTime(o.placed_at))}</div>
              <div style="font-size:0.73rem;color:hsl(var(--muted-foreground));">${fmtDateTime(o.placed_at)}</div>
            </div>
          </div>

          <div class="kitchen-ticket-banner ${bannerClass}">
            <span>${bannerLabel}</span>
            <span>R${fmtMoney(o.total_amount)}</span>
          </div>

          <div class="kitchen-ticket-body">
            ${o.special_instructions ? `
              <div class="prep-order-banner">
                <strong>🍳 Order Note:</strong> ${esc(o.special_instructions)}
              </div>
            ` : ''}

            <div>
              ${itemsHtml}
            </div>

            ${(() => {
              const rescue = typeof o.rescue_courier === 'string'
                ? (() => { try { return JSON.parse(o.rescue_courier); } catch { return null; } })()
                : o.rescue_courier;
              if (rescue?.name) {
                return `
                  <div style="background:#ecfdf5;border:1px solid #6ee7b7;border-radius:8px;padding:0.55rem 0.75rem;font-size:0.79rem;">
                    <strong>🛡️ Rescue Courier:</strong> ${esc(rescue.name)} ${rescue.plate ? `(${esc(rescue.plate)})` : ''}
                    ${rescue.phone ? ` · <a href="tel:${esc(rescue.phone)}" style="color:#047857;font-weight:700;">📞 ${esc(rescue.phone)}</a>` : ''}
                  </div>`;
              }
              if (o.driver_name) {
                return `
                  <div style="background:#eff6ff;border:1px solid #bfdbfe;border-radius:8px;padding:0.55rem 0.75rem;font-size:0.79rem;display:flex;justify-content:space-between;flex-wrap:wrap;gap:0.5rem;align-items:center;">
                    <span style="display:flex;align-items:center;gap:8px;">
                      ${renderDriverAvatarHtml(o.driver_image, o.driver_name)}
                      <span>
                        <strong>Driver:</strong> ${esc(o.driver_name)} ${o.driver_vehicle_plate ? `(${esc(o.driver_vehicle_plate)})` : ''}
                        ${o.driver_phone ? ` · <a href="tel:${esc(o.driver_phone)}" style="color:#1d4ed8;font-weight:700;">📞 ${esc(o.driver_phone)}</a>` : ''}
                      </span>
                    </span>
                    ${SUPPORT_PHONE ? `<a href="tel:${esc(SUPPORT_PHONE)}" style="color:#92400e;font-weight:700;font-size:0.75rem;">🛡️ Call Happy</a>` : ''}
                  </div>`;
              }
              return SUPPORT_PHONE && o.payment_status === 'completed'
                ? `<div style="background:#fffbeb;border:1px solid #fde68a;border-radius:8px;padding:0.45rem 0.75rem;font-size:0.77rem;display:flex;justify-content:space-between;align-items:center;">
                     <span style="color:#92400e;">${o.reassigned_at ? '🔄 Dispatch reassigning driver…' : 'Searching for driver…'}</span>
                     <a href="tel:${esc(SUPPORT_PHONE)}" style="color:#92400e;font-weight:700;">📞 Call Happy</a>
                   </div>`
                : '';
            })()}
          </div>

          <div class="kitchen-ticket-footer">
            <div style="display:flex;gap:0.35rem;flex-wrap:wrap;">
              <button type="button" class="btn btn-outline btn-sm" onclick="OrderDetails.printKitchenTicketById('${oid}', '/restaurant/api')">🖨 Ticket</button>
              <button type="button" class="btn btn-outline btn-sm" onclick="openOrderModal('${oid}')">Details</button>
            </div>
            <div style="display:flex;gap:0.35rem;flex-wrap:wrap;">
              ${o.status === 'pending' ? `
                <button type="button" class="btn btn-danger btn-sm" onclick="rejectOrder('${oid}', this)">Reject</button>
                <button type="button" class="btn btn-success btn-sm" onclick="acceptOrder('${oid}', this)">Accept Order</button>
              ` : ((o.status === 'ordering_at_restaurant' || o.status === 'accepted_by_driver') && o.payment_status === 'completed') ? `
                <button type="button" class="btn btn-primary btn-sm" onclick="updateOrderStatus('${oid}', 'order_ready', this)">Mark Ready</button>
              ` : ''}
            </div>
          </div>
        </div>
      `;
    }).join('');
  }

  async function refreshPortal() {
    try {
      const res = await fetch(`/restaurant/api/portal/summary?restaurantId=${encodeURIComponent(RESTAURANT_ID)}`);
      const data = await res.json();
      if (!data.success) return;

      const s = data.stats || {};
      document.getElementById('ovPendingOrders').textContent = s.pending_orders || 0;
      document.getElementById('ovActiveOrders').textContent = s.active_orders || 0;
      document.getElementById('ovTodayRevenue').textContent = 'R' + fmtMoney(s.today_revenue);
      document.getElementById('ovTodayOrders').textContent = s.today_orders || 0;
      document.getElementById('ovMenuItems').textContent = s.item_count || 0;
      document.getElementById('ovMenusCount').textContent = s.menu_count || 0;

      const badge = document.getElementById('sidebarPendingBadge');
      const prevPending = currentPendingCount;
      currentPendingCount = Number(s.pending_orders || 0);
      if (currentPendingCount > 0) {
        badge.style.display = 'inline-flex';
        badge.textContent = currentPendingCount;
        if (currentPendingCount > prevPending) {
          ringSilencedManually = false;
        }
        startOrderRinging();
      } else {
        badge.style.display = 'none';
        ringSilencedManually = false;
        stopOrderRinging(true);
      }

      const kitchenBadge = document.getElementById('sidebarKitchenBadge');
      if (kitchenBadge) {
        if ((s.kitchen_orders || 0) > 0) {
          kitchenBadge.style.display = 'inline-flex';
          kitchenBadge.textContent = s.kitchen_orders;
        } else {
          kitchenBadge.style.display = 'none';
        }
      }

      const orders = data.recentOrders || [];
      OrderDetails.rememberOrders(orders);
      const tbody = document.getElementById('ovRecentOrdersBody');
      if (!orders.length) {
        tbody.innerHTML = '<tr><td colspan="7" style="text-align:center;padding:2rem;color:hsl(var(--muted-foreground));">No orders yet for this restaurant.</td></tr>';
      } else {
        tbody.innerHTML = orders.map((o) => `
          <tr>
            <td><strong>#${esc(o.order_number || o.id.slice(0,8).toUpperCase())}</strong><div style="font-size:0.74rem;color:hsl(var(--muted-foreground));">${fmtDateTime(o.placed_at)}</div></td>
            <td>${esc(o.customer_name)}</td>
            <td>${OrderDetails.renderCompactItemsPreview(o.items, o.item_count)}</td>
            <td><strong>R${fmtMoney(o.total_amount)}</strong><div style="font-size:0.74rem;color:hsl(var(--muted-foreground));">${esc(o.payment_status)}</div></td>
            <td>${renderDriverSummaryCell(o)}</td>
            <td><span class="badge ${STATUS_BADGE_MAP[o.status] || 'badge-gray'}">${esc(fmtStatus(o.status, o.payment_status))}</span></td>
            <td style="text-align:right;">${renderOrderActionButtons(o)}</td>
          </tr>
        `).join('');
      }
    } catch (err) {
      console.error(err);
    }
  }

  async function loadOrders(page = 1) {
    currentOrderPage = page;
    const status = document.getElementById('orderFilterStatus').value;
    const date = document.getElementById('orderFilterDate').value;
    const params = new URLSearchParams({ restaurantId: RESTAURANT_ID, page, limit: 15 });
    if (status && status !== 'all') params.set('status', status);
    if (date) params.set('date', date);

    try {
      const res = await fetch('/restaurant/api/orders?' + params.toString());
      const data = await res.json();
      const tbody = document.getElementById('ordersTableBody');
      const orders = data.orders || [];
      OrderDetails.rememberOrders(orders);

      if (!orders.length) {
        tbody.innerHTML = '<tr><td colspan="8" style="text-align:center;padding:2rem;color:hsl(var(--muted-foreground));">No orders match these filters.</td></tr>';
      } else {
        tbody.innerHTML = orders.map((o) => `
          <tr>
            <td><strong>#${esc(o.order_number || o.id.slice(0,8).toUpperCase())}</strong></td>
            <td>${esc(o.customer_name)}</td>
            <td>${OrderDetails.renderCompactItemsPreview(o.items, o.item_count)}</td>
            <td><strong>R${fmtMoney(o.total_amount)}</strong><div style="font-size:0.73rem;color:hsl(var(--muted-foreground));">${esc(o.payment_status)}</div></td>
            <td>${renderDriverSummaryCell(o)}</td>
            <td><span class="badge ${STATUS_BADGE_MAP[o.status] || 'badge-gray'}">${esc(fmtStatus(o.status, o.payment_status))}</span></td>
            <td style="font-size:0.78rem;color:hsl(var(--muted-foreground));">${fmtDateTime(o.placed_at)}</td>
            <td style="text-align:right;">${renderOrderActionButtons(o)}</td>
          </tr>
        `).join('');
      }

      const pag = document.getElementById('ordersPagination');
      pag.innerHTML = `
        <span style="font-size:0.8rem;color:hsl(var(--muted-foreground));">Page ${data.currentPage || 1} of ${data.totalPages || 1} (${data.total || 0} orders)</span>
        <div style="display:flex;gap:0.4rem;">
          <button class="btn btn-outline btn-sm" ${(data.currentPage || 1) <= 1 ? 'disabled' : ''} onclick="loadOrders(${(data.currentPage || 1) - 1})">Previous</button>
          <button class="btn btn-outline btn-sm" ${(data.currentPage || 1) >= (data.totalPages || 1) ? 'disabled' : ''} onclick="loadOrders(${(data.currentPage || 1) + 1})">Next</button>
        </div>
      `;
    } catch (err) {
      console.error(err);
    }
  }

  function resetOrderFilters() {
    document.getElementById('orderFilterStatus').value = 'all';
    document.getElementById('orderFilterDate').value = '';
    loadOrders(1);
  }

  async function openOrderModal(orderId) {
    currentOrderIdOpen = orderId;
    document.getElementById('orderModalBody').innerHTML = '<div style="padding:1.5rem;text-align:center;">Loading order...</div>';
    openModal('orderDetailModal');

    try {
      const res = await fetch(`/restaurant/api/orders/${orderId}`);
      const data = await res.json();
      if (!data.success) throw new Error(data.error || 'Failed to load order');

      const o = data.order;
      const items = data.items || [];
      document.getElementById('orderModalTitle').textContent = `Order #${o.order_number || o.id.slice(0,8).toUpperCase()}`;

      document.getElementById('orderModalBody').innerHTML = OrderDetails.renderOrderDetailContent(o, items, {
        apiBase: '/restaurant/api',
        showRestaurant: false,
        supportPhone: SUPPORT_PHONE || o.support_phone || '',
        statusText: fmtStatus(o.status, o.payment_status),
        statusBadgeClass: STATUS_BADGE_MAP[o.status] || 'badge-gray',
        paymentText: o.payment_status === 'completed' ? 'Paid' : (o.payment_status || 'Pending'),
        paymentBadgeClass: o.payment_status === 'completed' ? 'badge-green' : 'badge-yellow',
        paymentMethodText: o.payment_method || 'card',
      });

      document.getElementById('orderModalFooter').innerHTML = `
        ${o.status === 'pending' ? `
          <button class="btn btn-danger" onclick="rejectOrder('${o.id}', this)">Reject Order</button>
          <button class="btn btn-success" onclick="acceptOrder('${o.id}', this)">Accept Order</button>
        ` : (['ordering_at_restaurant', 'accepted_by_driver'].includes(o.status) && o.payment_status === 'completed') ? `
          <button class="btn btn-primary" onclick="updateOrderStatus('${o.id}', 'order_ready', this)">Mark Ready for Pickup</button>
        ` : ''}
        <button class="btn btn-outline" onclick="closeModal('orderDetailModal')">Close</button>
      `;
    } catch (err) {
      document.getElementById('orderModalBody').innerHTML = `<div style="color:#dc2626;">${esc(err.message)}</div>`;
    }
  }

  async function acceptOrder(id, btn) {
    if (btn) btn.disabled = true;
    try {
      const res = await fetch(`/restaurant/api/orders/${id}/accept`, { method: 'POST' });
      const data = await res.json();
      if (!data.success) throw new Error(data.error || 'Failed to accept');
      showToast('Order Accepted', data.message);
      refreshPortal();
      loadKitchenOrders();
      loadOrders(currentOrderPage);
      if (currentOrderIdOpen === id) openOrderModal(id);
    } catch (err) {
      showToast('Error', err.message);
      if (btn) btn.disabled = false;
    }
  }

  async function rejectOrder(id, btn) {
    if (!confirm('Reject and cancel this order? Any completed payment will be refunded automatically.')) return;
    if (btn) btn.disabled = true;
    try {
      const res = await fetch(`/restaurant/api/orders/${id}/reject`, { method: 'POST' });
      const data = await res.json();
      if (!data.success) throw new Error(data.error || 'Failed to reject');
      showToast('Order Rejected', data.message);
      refreshPortal();
      loadKitchenOrders();
      loadOrders(currentOrderPage);
      if (currentOrderIdOpen === id) openOrderModal(id);
    } catch (err) {
      showToast('Error', err.message);
      if (btn) btn.disabled = false;
    }
  }

  async function updateOrderStatus(id, status, btn) {
    if (btn) btn.disabled = true;
    try {
      const res = await fetch(`/restaurant/api/orders/${id}/status`, {
        method: 'PATCH',
        headers: { 'Content-Type': 'application/json' },
        body: JSON.stringify({ status }),
      });
      const data = await res.json();
      if (!data.success) throw new Error(data.error || 'Status update failed');
      showToast('Order Updated', `Order marked as ${status.replace(/_/g, ' ')}.`);
      refreshPortal();
      loadKitchenOrders();
      loadOrders(currentOrderPage);
      if (currentOrderIdOpen === id) openOrderModal(id);
    } catch (err) {
      showToast('Error', err.message);
      if (btn) btn.disabled = false;
    }
  }

  // ── MENUS & ITEMS (Shared Admin MenuEditor Engine) ─────────────────────────
  MenuEditor.init({
    apiBase: '/restaurant/api',
    uploadEndpoint: '/restaurant/api/upload',
    getRestaurantId: () => RESTAURANT_ID,
    notify: (title, msg) => showToast(title, msg),
    onChanged: () => refreshPortal(),
  });
  function loadMenus() {
    return MenuEditor.loadMenus();
  }

  // ── SETTINGS & STORE TOGGLE ────────────────────────────────────────────────
  function switchSettingsPane(pane, btn) {
    document.querySelectorAll('.settings-pane').forEach((p) => p.classList.remove('active'));
    document.querySelectorAll('.settings-tab-btn').forEach((b) => b.classList.remove('active'));
    document.getElementById('pane-' + pane)?.classList.add('active');
    if (btn) btn.classList.add('active');
    if (pane === 'location') updateStoreMap();
  }

  function updateStoreMap() {
    const lat = document.getElementById('st_lat')?.value?.trim();
    const lng = document.getElementById('st_lng')?.value?.trim();
    const box = document.getElementById('storeMapPreview');
    if (!box) return;
    if (lat && lng) {
      box.innerHTML = `<iframe width="100%" height="100%" frameborder="0" style="border:0;" src="https://maps.google.com/maps?q=${encodeURIComponent(lat)},${encodeURIComponent(lng)}&z=15&output=embed"></iframe>`;
    } else {
      box.innerHTML = '<div style="display:flex;height:100%;align-items:center;justify-content:center;color:#64748b;font-size:0.85rem;">Enter coordinates to preview map</div>';
    }
  }

  function detectStoreLocation() {
    navigator.geolocation?.getCurrentPosition((pos) => {
      document.getElementById('st_lat').value = pos.coords.latitude.toFixed(6);
      document.getElementById('st_lng').value = pos.coords.longitude.toFixed(6);
      updateStoreMap();
    });
  }

  async function uploadImageToField(fileInput, targetInputId) {
    const file = fileInput.files?.[0];
    if (!file) return;
    const fd = new FormData();
    fd.append('image', file);
    showToast('Uploading Image...', file.name);
    try {
      const res = await fetch('/restaurant/api/upload', { method: 'POST', body: fd });
      const data = await res.json();
      if (!data.success) throw new Error(data.error || 'Upload failed');
      document.getElementById(targetInputId).value = data.url;
      showToast('Upload Complete', 'Image URL filled automatically.');
    } catch (err) {
      showToast('Upload Note', err.message);
    }
  }

  async function saveStoreSettings(e) {
    e.preventDefault();
    const form = e.target;
    const fd = new FormData(form);
    const payload = Object.fromEntries(fd.entries());
    payload.restaurantId = RESTAURANT_ID;
    payload.is_active = form.querySelector('input[name="is_active"]').checked ? 'true' : 'false';
    payload.is_accepting_orders = form.querySelector('input[name="is_accepting_orders"]').checked ? 'true' : 'false';

    const btn = document.getElementById('saveSettingsBtn');
    btn.disabled = true;
    try {
      const res = await fetch('/restaurant/api/restaurant', {
        method: 'PUT',
        headers: { 'Content-Type': 'application/json' },
        body: JSON.stringify(payload),
      });
      const data = await res.json();
      if (!data.success) throw new Error(data.error || 'Update failed');
      showToast('Settings Saved', 'Your restaurant profile has been updated.');
      const acceptBtn = document.getElementById('acceptingOrdersBtn');
      const accepting = Boolean(data.restaurant.is_accepting_orders);
      acceptBtn.className = 'btn btn-sm ' + (accepting ? 'btn-success' : 'btn-outline');
      acceptBtn.textContent = accepting ? '● Accepting Orders' : '○ Orders Paused';
    } catch (err) {
      showToast('Error', err.message);
    } finally {
      btn.disabled = false;
    }
  }

  async function toggleAcceptingOrders() {
    const res = await fetch(`/restaurant/api/restaurant/toggle-accepting?restaurantId=${encodeURIComponent(RESTAURANT_ID)}`, {
      method: 'PATCH',
    });
    const data = await res.json();
    if (data.success) {
      const accepting = Boolean(data.restaurant.is_accepting_orders);
      const btn = document.getElementById('acceptingOrdersBtn');
      btn.className = 'btn btn-sm ' + (accepting ? 'btn-success' : 'btn-outline');
      btn.textContent = accepting ? '● Accepting Orders' : '○ Orders Paused';
      showToast('Store Status Changed', accepting ? 'Your restaurant is accepting new orders.' : 'New orders paused temporarily.');
    }
  }

  document.addEventListener('DOMContentLoaded', () => {
    if (window.innerWidth <= 820) document.getElementById('mobileMenuBtn').style.display = 'inline-flex';
    updateRingToggleButton();
    refreshPortal();
    if ("<%= activeSection %>" === 'kitchen') loadKitchenOrders();
    if ("<%= activeSection %>" === 'orders') loadOrders(1);
    if ("<%= activeSection %>" === 'menus') loadMenus();
    if ("<%= activeSection %>" === 'settings') updateStoreMap();

    // Safety fallback poll every 25s when visible so missed socket events still trigger kitchen ringtone
    setInterval(() => {
      if (!document.hidden) refreshPortal();
    }, 25000);

    if (typeof io !== 'undefined') {
      const socket = io();
      socket.on('connect', () => {
        socket.emit('join_manager_room', { managerId: MANAGER_ID, restaurantIds: RESTAURANT_IDS });
        document.getElementById('socketStateText').textContent = 'Live Connected';
      });
      socket.on('new_order', (payload) => {
        ringSilencedManually = false;
        currentPendingCount = Math.max(1, currentPendingCount + 1);
        startOrderRinging(payload?.order_number || '');
        showToast('🔔 New Incoming Order!', `Order #${payload?.order_number || ''} requires your acceptance.`);
        refreshPortal();
        loadKitchenOrders();
        loadOrders(currentOrderPage);
      });
      socket.on('driver_assigned', (payload) => {
        showToast('🚗 Driver Accepted Order', `A driver accepted Order #${payload?.order_number || ''}!`);
        refreshPortal();
        loadKitchenOrders();
        loadOrders(currentOrderPage);
        if (currentOrderIdOpen && currentOrderIdOpen === payload?.order_id) openOrderModal(currentOrderIdOpen);
      });
      socket.on('driver_reassigned', (payload) => {
        showToast('🔄 Driver Updated', `Dispatch updated driver assignment on Order #${payload?.order_number || ''}.`);
        refreshPortal();
        loadKitchenOrders();
        loadOrders(currentOrderPage);
        if (currentOrderIdOpen && currentOrderIdOpen === payload?.order_id) openOrderModal(currentOrderIdOpen);
      });
      socket.on('order_updated', (payload) => {
        refreshPortal();
        loadKitchenOrders();
        loadOrders(currentOrderPage);
        if (currentOrderIdOpen && (currentOrderIdOpen === payload?.orderId || currentOrderIdOpen === payload?.order?.id)) {
          openOrderModal(currentOrderIdOpen);
        }
      });
    }
  });
</script>
</body>
</html>
