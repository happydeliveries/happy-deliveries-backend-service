              <svg xmlns="http://www.w3.org/2000/svg" width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" class="lucide lucide-receipt-text-icon lucide-receipt-text"><path d="M13 16H8"/><path d="M14 8H8"/><path d="M16 12H8"/><path d="M4 3a1 1 0 0 1 1-1 1.3 1.3 0 0 1 .7.2l.933.6a1.3 1.3 0 0 0 1.4 0l.934-.6a1.3 1.3 0 0 1 1.4 0l.933.6a1.3 1.3 0 0 0 1.4 0l.933-.6a1.3 1.3 0 0 1 1.4 0l.934.6a1.3 1.3 0 0 0 1.4 0l.933-.6A1.3 1.3 0 0 1 19 2a1 1 0 0 1 1 1v18a1 1 0 0 1-1 1 1.3 1.3 0 0 1-.7-.2l-.933-.6a1.3 1.3 0 0 0-1.4 0l-.934.6a1.3 1.3 0 0 1-1.4 0l-.933-.6a1.3 1.3 0 0 0-1.4 0l-.933.6a1.3 1.3 0 0 1-1.4 0l-.934-.6a1.3 1.3 0 0 0-1.4 0l-.933.6a1.3 1.3 0 0 1-.7.2 1 1 0 0 1-1-1z"/></svg>
              <span>Orders</span>
            </a>
          </li>
          <li>
            <a href="/manager/drivers" class="sidebar-menu-item">
              <svg xmlns="http://www.w3.org/2000/svg" width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M19 17h2c.6 0 1-.4 1-1v-3c0-.9-.7-1.7-1.5-1.9C18.7 10.6 16 10 16 10s-1.3-1.4-2.2-2.3c-.5-.4-1.1-.7-1.8-.7H5c-.6 0-1.1.4-1.4.9l-1.4 2.9A3.7 3.7 0 0 0 2 12v4c0 .6.4 1 1 1h2"/><circle cx="7" cy="17" r="2"/><path d="M9 17h6"/><circle cx="17" cy="17" r="2"/></svg>
              <span>Manage Drivers</span>
            </a>
          </li>
          <li>
            <a href="/manager/analytics" class="sidebar-menu-item">
              <svg xmlns="http://www.w3.org/2000/svg" width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M3 3v18h18"/><path d="M18 17V9"/><path d="M13 17V5"/><path d="M8 17v-3"/></svg>
              <span>Analytics</span>
            </a>
          </li>
          <li>
            <a href="/manager/settings" class="sidebar-menu-item">
              <svg xmlns="http://www.w3.org/2000/svg" width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M12.22 2h-.44a2 2 0 0 0-2 2v.18a2 2 0 0 1-1 1.73l-.43.25a2 2 0 0 1-2 0l-.15-.08a2 2 0 0 0-2.73.73l-.22.38a2 2 0 0 0 .73 2.73l.15.1a2 2 0 0 1 1 1.72v.51a2 2 0 0 1-1 1.74l-.15.09a2 2 0 0 0-.73 2.73l.22.38a2 2 0 0 0 2.73.73l.15-.08a2 2 0 0 1 2 0l.43.25a2 2 0 0 1 1 1.73V20a2 2 0 0 0 2 2h.44a2 2 0 0 0 2-2v-.18a2 2 0 0 1 1-1.73l.43-.25a2 2 0 0 1 2 0l.15.08a2 2 0 0 0 2.73-.73l.22-.39a2 2 0 0 0-.73-2.73l-.15-.08a2 2 0 0 1-1-1.74v-.5a2 2 0 0 1 1-1.74l.15-.09a2 2 0 0 0 .73-2.73l-.22-.38a2 2 0 0 0-2.73-.73l-.15.08a2 2 0 0 1-2 0l-.43-.25a2 2 0 0 1-1-1.73V4a2 2 0 0 0-2-2z"/><circle cx="12" cy="12" r="3"/></svg>
              <span>Settings</span>
            </a>
          </li>
        </ul>
      </nav>
      <div class="sidebar-footer">
        <div class="sidebar-user">
          <div class="avatar">
            <%= manager ? (manager.first_name?.[0] || 'M') + (manager.last_name?.[0] || 'R') : 'MR' %>
          </div>
          <div class="sidebar-user-info">
            <span class="sidebar-user-name">
              <%= manager ? (manager.first_name + ' ' + manager.last_name) : 'Manager User' %>
            </span>
            <span class="sidebar-user-role">Restaurant Manager</span>
          </div>
        </div>
      </div>
    </aside>

    <!-- Main Content -->
    <main class="main-content">
      <!-- Topbar -->
      <div class="topbar">
        <div class="topbar-search">
          <div class="search-input-wrapper">
            <!-- <svg xmlns="http://www.w3.org/2000/svg" width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><circle cx="11" cy="11" r="8"/><path d="m21 21-4.3-4.3"/></svg> -->
            <input type="text" class="search-input" placeholder="Search orders, restaurants, menus...">
          </div>
        </div>
        <div class="topbar-actions">
          <div class="dropdown">
            <button class="btn btn-ghost btn-icon notification-btn" onclick="toggleDropdown(this)">
              <svg xmlns="http://www.w3.org/2000/svg" width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M6 8a6 6 0 0 1 12 0c0 7 3 9 3 9H3s3-2 3-9"/><path d="M10.3 21a1.94 1.94 0 0 0 3.4 0"/></svg>
              <span class="notification-badge">3</span>
            </button>
            <div class="dropdown-content" style="width: 20rem;">
              <div class="dropdown-label">Notifications</div>
              <div class="dropdown-separator"></div>
              <div class="dropdown-item" style="flex-direction: column; align-items: flex-start;">
                <span class="font-medium">New order received</span>
                <span class="text-muted" style="font-size: 0.75rem;">Order #1024 from TechCorp</span>
              </div>
              <div class="dropdown-item" style="flex-direction: column; align-items: flex-start;">
                <span class="font-medium">Menu item out of stock</span>
                <span class="text-muted" style="font-size: 0.75rem;">Grilled Salmon marked unavailable</span>
              </div>
              <div class="dropdown-item" style="flex-direction: column; align-items: flex-start;">
                <span class="font-medium">Review submitted</span>
                <span class="text-muted" style="font-size: 0.75rem;">5-star review from Sarah J.</span>
              </div>
            </div>
          </div>
          <div class="dropdown">
            <button class="btn btn-ghost btn-icon" onclick="toggleDropdown(this)" style="border-radius: 50%;">
              <div class="avatar">
                <%= manager ? (manager.first_name?.[0] || 'M') + (manager.last_name?.[0] || 'R') : 'MR' %>
              </div>
            </button>
            <div class="dropdown-content">
              <div class="dropdown-label">My Account</div>
              <div class="dropdown-separator"></div>
              <div class="dropdown-item">Profile</div>
              <div class="dropdown-item">Settings</div>
              <div class="dropdown-separator"></div>
              <a href="/manager/logout" class="dropdown-item" style="text-decoration:none;color:inherit;">Log out</a>
            </div>
          </div>
        </div>
      </div>

      <!-- Page Content -->
      <div class="page-container">
        <div class="page-header">
          <div>
            <h1 class="page-title">My Restaurants</h1>
            <p class="text-muted">Manage your restaurant locations, settings, and availability</p>
          </div>
          <button class="btn btn-primary" onclick="openModal('addRestaurantModal')">
            <svg xmlns="http://www.w3.org/2000/svg" width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M5 12h14"/><path d="M12 5v14"/></svg>
            Add Restaurant
          </button>
        </div>

        <% if (!restaurants || restaurants.length === 0) { %>
          <!-- Empty State -->
          <div class="empty-state">
            <svg xmlns="http://www.w3.org/2000/svg" width="64" height="64" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round"><path d="M15 21v-8a1 1 0 0 0-1-1h-4a1 1 0 0 0-1 1v8"/><path d="M3 10a2 2 0 0 1 2-2h14a2 2 0 0 1 2 2v11H3z"/><path d="M8 10V7a2 2 0 0 1 2-2h4a2 2 0 0 1 2 2v3"/></svg>
            <h3 style="font-size: 1.25rem; font-weight: 600; margin-bottom: 0.5rem;">No Restaurants Yet</h3>
            <p class="text-muted">Add your first restaurant to start receiving orders.</p>
            <button class="btn btn-primary mt-4" onclick="openModal('addRestaurantModal')">
              <svg xmlns="http://www.w3.org/2000/svg" width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M5 12h14"/><path d="M12 5v14"/></svg>
              Add Restaurant
            </button>
          </div>
        <% } else { %>
          <!-- Restaurants Grid -->
          <div class="grid grid-3">
            <% restaurants.forEach(function(r) { %>
              <div class="card restaurant-card">
                <div class="restaurant-cover">
                  <% if (r.cover_image_url) { %>
                    <img src="<%= r.cover_image_url %>" alt="<%= r.name %>">
                  <% } else { %>
                    <svg xmlns="http://www.w3.org/2000/svg" width="48" height="48" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round" style="color: white; opacity: 0.5;"><path d="M15 21v-8a1 1 0 0 0-1-1h-4a1 1 0 0 0-1 1v8"/><path d="M3 10a2 2 0 0 1 2-2h14a2 2 0 0 1 2 2v11H3z"/><path d="M8 10V7a2 2 0 0 1 2-2h4a2 2 0 0 1 2 2v3"/></svg>
                  <% } %>
                  <div class="restaurant-logo">
                    <% if (r.logo_url) { %>
                      <img src="<%= r.logo_url %>" alt="logo">
                    <% } else { %>
                      <svg xmlns="http://www.w3.org/2000/svg" width="28" height="28" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M4 19.5v-15A2.5 2.5 0 0 1 6.5 2H19a1 1 0 0 1 1 1v18a1 1 0 0 1-1 1H6.5a1 1 0 0 1 0-5H20"/></svg>
                    <% } %>
                  </div>
                </div>
                <div class="restaurant-body">
                  <div class="restaurant-header">
                    <div>
                      <h3><%= r.name %></h3>
                      <div style="display: flex; gap: 0.5rem; margin-top: 0.25rem; flex-wrap: wrap;">
                        <% if (r.is_active) { %>
                          <span class="badge badge-green">Active</span>
                        <% } else { %>
                          <span class="badge badge-red">Inactive</span>
                        <% } %>
                        <% if (r.is_accepting_orders) { %>
                          <span class="badge badge-blue">Accepting Orders</span>
                        <% } else { %>
                          <span class="badge badge-gray">Not Accepting</span>
                        <% } %>
                      </div>
                    </div>
                  </div>
                  <div class="restaurant-meta">
                    <div class="flex items-center gap-2">
                      <svg xmlns="http://www.w3.org/2000/svg" width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M4 19.5v-15A2.5 2.5 0 0 1 6.5 2H19a1 1 0 0 1 1 1v18a1 1 0 0 1-1 1H6.5a1 1 0 0 1 0-5H20"/></svg>
                      <%= r.cuisine_type || 'Multi-cuisine' %>
                    </div>
                    <div class="flex items-center gap-2">
                      <svg xmlns="http://www.w3.org/2000/svg" width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" class="lucide lucide-map-pin-house-icon lucide-map-pin-house"><path d="M15 22a1 1 0 0 1-1-1v-4a1 1 0 0 1 .445-.832l3-2a1 1 0 0 1 1.11 0l3 2A1 1 0 0 1 22 17v4a1 1 0 0 1-1 1z"/><path d="M18 10a8 8 0 0 0-16 0c0 4.993 5.539 10.193 7.399 11.799a1 1 0 0 0 .601.2"/><path d="M18 22v-3"/><circle cx="10" cy="10" r="3"/></svg>
                      <!-- <svg xmlns="http://www.w3.org/2000/svg" width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M20 10c0 6-8 12-8 12s-8-6-8-12a8 8 0 0 1 16 0Z"/><circle cx="12" cy="10" r="3"/></svg> -->
                      <a href="https://www.google.com/maps/search/?api=1&query=<%= encodeURIComponent(r.address) %>" target="_blank" class="location-link">
                        <span class="truncate"><%= r.address ? (r.address.length > 50 ? r.address.substring(0, 50) + '...' : r.address) : 'N/A' %></span>
                      </a>
                    </div>
                    <div class="flex items-center gap-2">
                      <svg xmlns="http://www.w3.org/2000/svg" width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><circle cx="12" cy="12" r="10"/><polyline points="12 6 12 12 16 14"/></svg>
                      <%= r.opening_hours ? (typeof r.opening_hours === 'object' ? (r.opening_hours.display || 'N/A') : (function(){ try { return JSON.parse(r.opening_hours).display || 'N/A'; } catch(e){ return 'N/A'; } })()) : 'N/A' %> • <%= r.preparation_time_minutes || 20 %> min prep
                    </div>
                  </div>
                  
                  <div class="restaurant-actions">
                    <a href="/manager/restaurants/edit/<%= r.id %>" class="btn btn-outline btn-sm">
                      <svg xmlns="http://www.w3.org/2000/svg" width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M17 3a2.85 2.83 0 1 1 4 4L7.5 20.5 2 22l1.5-5.5Z"/></svg>
                      Edit
                    </a>
                    <form method="POST" action="/manager/restaurants/<%= r.id %>/toggle-status" style="flex: 1; display: inline;">
                      <button type="submit" class="btn btn-warning-outline btn-sm" style="width: 100%;">
                        <svg xmlns="http://www.w3.org/2000/svg" width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M18.36 6.64a9 9 0 1 1-12.73 0"/><line x1="12" x2="12" y1="2" y2="12"/></svg>
                        <%= r.is_active ? 'Deactivate' : 'Activate' %>
                      </button>
                    </form>
                    <form method="POST" action="/manager/restaurants/delete/<%= r.id %>" style="flex: 1; display: inline;" onsubmit="return confirm('Delete <%= r.name.replace(/'/g, "\\'") %>? This cannot be undone.');">
                      <button type="submit" class="btn btn-destructive btn-sm" style="width: 100%;">
                        <svg xmlns="http://www.w3.org/2000/svg" width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M3 6h18"/><path d="M19 6v14c0 1-1 2-2 2H7c-1 0-2-1-2-2V6"/><path d="M8 6V4c0-1 1-2 2-2h4c1 0 2 1 2 2v2"/></svg>
                        Delete
                      </button>
                    </form>
                  </div>
                </div>
              </div>
            <% }); %>
          </div>
        <% } %>
      </div>
    </main>
  </div>

  <!-- Add Restaurant Modal -->
  <div class="modal-overlay" id="addRestaurantModal">
    <div class="modal">
      <form method="POST" action="/manager/restaurants/add">
        <div class="modal-header">
          <div>
            <h3 class="modal-title">Add Restaurant</h3>
            <p class="modal-description">Create a new restaurant location</p>
          </div>
          <button type="button" class="btn btn-ghost btn-icon" onclick="closeModal('addRestaurantModal')">
            <svg xmlns="http://www.w3.org/2000/svg" width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M18 6 6 18"/><path d="m6 6 12 12"/></svg>
          </button>
        </div>
        <div class="modal-body">
          <div class="form-row">
            <div class="form-group">
              <label class="form-label">Restaurant Name <span style="color: hsl(var(--destructive)); font-size: 0.75rem;">* Required</span></label>
              <input type="text" name="name" required placeholder="e.g. The Burger Joint">
            </div>
            <div class="form-group">
              <label class="form-label">Cuisine Type</label>
              <input type="text" name="cuisine_type" placeholder="e.g. Italian, African, Fast Food">
            </div>
          </div>
          <div class="form-row">
            <div class="form-group">
              <label class="form-label">Phone Number</label>
              <input type="tel" name="phone_number" placeholder="e.g. 0831234567">
            </div>
            <div class="form-group">
              <label class="form-label">Email</label>
              <input type="email" name="email" placeholder="contact@restaurant.com">
            </div>
          </div>
          <div class="form-group">
            <label class="form-label">Address <span style="color: hsl(var(--destructive)); font-size: 0.75rem;">* Required</span></label>
            <textarea name="address" rows="2" required placeholder="123 Main Street, Johannesburg"></textarea>
          </div>
          <div class="form-row-3">
            <div class="form-group">
              <label class="form-label">Latitude <span style="color: hsl(var(--destructive)); font-size: 0.75rem;">* Required</span></label>
              <input type="number" step="any" name="latitude" required placeholder="-26.2041">
            </div>
            <div class="form-group">
              <label class="form-label">Longitude <span style="color: hsl(var(--destructive)); font-size: 0.75rem;">* Required</span></label>
              <input type="number" step="any" name="longitude" required placeholder="28.0473">
            </div>
            <div class="form-group">
              <label class="form-label">Delivery Radius (km)</label>
              <input type="number" name="delivery_radius_km" value="5" min="1" max="50">
            </div>
          </div>
          <div class="form-row">
            <div class="form-group">
              <label class="form-label">Logo URL</label>
              <input type="url" name="logo_url" placeholder="https://...">
            </div>
            <div class="form-group">
              <label class="form-label">Cover Image URL</label>
              <input type="url" name="cover_image_url" placeholder="https://...">
            </div>
          </div>
          <div class="form-group">
            <label class="form-label">Opening Hours <span style="color: hsl(var(--destructive)); font-size: 0.75rem;">* Required</span></label>
            <input type="text" name="opening_hours_display" value="08:00 - 21:00" placeholder="e.g. 08:00 - 21:00" required>
          </div>
          <div class="form-row">
            <div class="form-group">
              <label class="form-label">Preparation Time (minutes)</label>
              <input type="number" name="preparation_time_minutes" value="20" min="5" max="120">
            </div>
            <div class="form-group">
              <label class="form-label">Description</label>
              <textarea name="description" rows="1" placeholder="Brief description of your restaurant"></textarea>
            </div>
          </div>
          <div class="form-row">
            <div class="switch-row" style="border: 1px solid hsl(var(--border)); border-radius: var(--radius); padding: 0.75rem 1rem;">
              <div class="switch-info">
                <span class="switch-label">Restaurant Active</span>
                <span class="switch-description">Make restaurant visible to customers</span>
              </div>
              <div class="switch active" onclick="toggleSwitch(this, 'add_is_active')">
                <div class="switch-thumb"></div>
              </div>
              <input type="hidden" name="is_active" id="add_is_active" value="on">
            </div>
            <div class="switch-row" style="border: 1px solid hsl(var(--border)); border-radius: var(--radius); padding: 0.75rem 1rem;">
              <div class="switch-info">
                <span class="switch-label">Accepting Orders</span>
                <span class="switch-description">Allow customers to place new orders</span>
              </div>
              <div class="switch active" onclick="toggleSwitch(this, 'add_is_accepting')">
                <div class="switch-thumb"></div>
              </div>
              <input type="hidden" name="is_accepting_orders" id="add_is_accepting" value="on">
            </div>
          </div>
        </div>
        <div class="modal-footer">
          <button type="button" class="btn btn-outline" onclick="closeModal('addRestaurantModal')">Cancel</button>
          <button type="submit" class="btn btn-primary">
            <svg xmlns="http://www.w3.org/2000/svg" width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M19 21H5a2 2 0 0 1-2-2V5a2 2 0 0 1 2-2h11l5 5v11a2 2 0 0 1-2 2Z"/><polyline points="17 21 17 13 7 13 7 21"/><polyline points="7 3 7 8 15 8"/></svg>
            Save Restaurant
          </button>
        </div>
      </form>
    </div>
  </div>

  <!-- Toast Container -->
  <div class="toast-container" id="toastContainer"></div>
  <script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.0/dist/js/bootstrap.bundle.min.js"></script>
  <script src="/socket.io/socket.io.js"></script>
  <script src="/js/manager.js"></script>
  <script>
    // Dropdown
    function toggleDropdown(btn) {
      const dropdown = btn.closest('.dropdown');
      document.querySelectorAll('.dropdown').forEach(d => {
        if (d !== dropdown) d.classList.remove('active');
      });
      dropdown.classList.toggle('active');
    }

    document.addEventListener('click', (e) => {
      if (!e.target.closest('.dropdown')) {
        document.querySelectorAll('.dropdown').forEach(d => d.classList.remove('active'));
      }
    });

    // Modal
    function openModal(id) {
      document.getElementById(id).classList.add('active');
    }

    function closeModal(id) {
      document.getElementById(id).classList.remove('active');
    }

    document.querySelectorAll('.modal-overlay').forEach(overlay => {
      overlay.addEventListener('click', (e) => {
        if (e.target === overlay) overlay.classList.remove('active');
      });
    });

    // Toast
    function showToast(title, description) {
      const container = document.getElementById('toastContainer');
      const toast = document.createElement('div');
      toast.className = 'toast';
      toast.innerHTML = `
        <div class="toast-title">${title}</div>
        <div class="toast-description">${description}</div>
      `;
      container.appendChild(toast);
      setTimeout(() => toast.classList.add('show'), 10);
      setTimeout(() => {
        toast.classList.remove('show');
        setTimeout(() => toast.remove(), 300);
      }, 3000);
    }

    // Switch toggle with hidden input
    function toggleSwitch(el, inputId) {
      el.classList.toggle('active');
      if (inputId) {
        const input = document.getElementById(inputId);
        input.value = el.classList.contains('active') ? 'on' : '';
      }
    }
  </script>
</body>
</html>