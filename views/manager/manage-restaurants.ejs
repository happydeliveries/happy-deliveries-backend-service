<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title>Manage Restaurants - Happy Deliveries Admin</title>
  <link href="https://fonts.googleapis.com/css2?family=Inter:wght@400;500;600;700&display=swap" rel="stylesheet">
  <link rel="stylesheet" href="/css/main.css">
  <style>
    .topbar {
      display: flex;
      align-items: center;
      justify-content: space-between;
      padding: 1.5rem;
      border-bottom: 1px solid hsl(var(--border));
      background: hsl(var(--background));
      position: sticky;
      top: 0;
      z-index: 40;
    }
    .topbar-search { flex: 1; max-width: 28rem; }
    .search-input-wrapper { position: relative; }
    .search-input-wrapper svg {
      position: absolute; left: 0.75rem; top: 50%; transform: translateY(-50%);
      width: 1rem; height: 1rem; color: hsl(var(--muted-foreground));
    }
    .search-input {
      width: 100%; padding: 0.5rem 0.75rem 0.5rem 2.5rem;
      border: 1px solid hsl(var(--input)); border-radius: var(--radius);
      font-size: 0.875rem; background: hsl(var(--background));
      color: hsl(var(--foreground)); outline: none;
      transition: border-color 0.15s, box-shadow 0.15s;
    }
    .search-input:focus {
      border-color: hsl(var(--ring));
      box-shadow: 0 0 0 2px hsla(var(--ring), 0.2);
    }
    .topbar-actions { display: flex; align-items: center; gap: 0.75rem; }

    .btn {
      display: inline-flex; align-items: center; justify-content: center; gap: 0.45rem;
      padding: 0.5rem 0.95rem; border-radius: var(--radius); font-size: 0.85rem;
      font-weight: 500; cursor: pointer; transition: all 0.15s;
      border: none; text-decoration: none; line-height: 1.1; white-space: nowrap;
    }
    .btn svg { width: 1rem; height: 1rem; flex-shrink: 0; }
    .btn-primary { background: hsl(var(--primary)); color: hsl(var(--primary-foreground)); }
    .btn-primary:hover { opacity: 0.9; }
    .btn-success { background: #16a34a; color: #ffffff; }
    .btn-success:hover { background: #15803d; }
    .btn-danger { background: #dc2626; color: #ffffff; }
    .btn-danger:hover { background: #b91c1c; }
    .btn-outline {
      background: transparent; border: 1px solid hsl(var(--input));
      color: hsl(var(--foreground));
    }
    .btn-outline:hover { background: hsl(var(--accent)); }
    .btn-ghost { background: transparent; color: hsl(var(--foreground)); }
    .btn-ghost:hover { background: hsl(var(--accent)); }
    .btn-sm { padding: 0.35rem 0.65rem; font-size: 0.75rem; }

    .badge {
      display: inline-flex; align-items: center; gap: 0.35rem;
      padding: 0.22rem 0.6rem; border-radius: 9999px;
      font-size: 0.72rem; font-weight: 600;
    }
    .badge-yellow { background: #fef3c7; color: #92400e; }
    .badge-green  { background: #dcfce7; color: #166534; }
    .badge-red    { background: #fee2e2; color: #991b1b; }
    .badge-blue   { background: #dbeafe; color: #1e40af; }
    .badge-gray   { background: #f3f4f6; color: #374151; }

    .avatar {
      width: 2.15rem; height: 2.15rem; border-radius: 50%; overflow: hidden;
      background: hsl(var(--muted)); display: flex; align-items: center; justify-content: center;
      font-size: 0.75rem; font-weight: 600; color: hsl(var(--muted-foreground));
      flex-shrink: 0;
    }
    .avatar img { width: 100%; height: 100%; object-fit: cover; }

    .card {
      background: hsl(var(--card)); border: 1px solid hsl(var(--border));
      border-radius: var(--radius); overflow: hidden;
    }
    .card-header { padding: 1.15rem 1.4rem; display: flex; flex-direction: column; gap: 0.25rem; }
    .card-title { font-size: 1rem; font-weight: 600; }
    .card-content { padding: 0 1.4rem 1.35rem; }
    .card-content-full { padding: 0; }
    .stat-card .card-header {
      display: flex; flex-direction: row; align-items: center; justify-content: space-between;
      padding-bottom: 0.4rem;
    }
    .stat-card .card-title { font-size: 0.85rem; font-weight: 500; }
    .stat-value { font-size: 1.55rem; font-weight: 700; }
    .stat-description { font-size: 0.75rem; color: hsl(var(--muted-foreground)); margin-top: 0.15rem; }

    .page-container { padding: 1.5rem 2rem; display: flex; flex-direction: column; gap: 1.5rem; }
    .page-header { display: flex; align-items: center; justify-content: space-between; flex-wrap: wrap; gap: 1rem; }
    .page-title { font-size: 1.875rem; font-weight: 700; letter-spacing: -0.025em; }
    .page-actions { display: flex; align-items: center; gap: 0.5rem; flex-wrap: wrap; }

    .grid-5 {
      display: grid; grid-template-columns: repeat(5, 1fr); gap: 1rem;
    }
    @media (max-width: 1200px) { .grid-5 { grid-template-columns: repeat(3, 1fr); } }
    @media (max-width: 768px) { .grid-5 { grid-template-columns: 1fr; } }

    .filters-card {
      background: hsl(var(--card)); border: 1px solid hsl(var(--border));
      border-radius: var(--radius); padding: 1.15rem 1.4rem;
      display: flex; gap: 1rem; flex-wrap: wrap; align-items: flex-end;
    }
    .filter-group { flex: 1; min-width: 165px; }
    .filter-label { font-size: 0.78rem; font-weight: 600; color: hsl(var(--muted-foreground)); margin-bottom: 0.35rem; display: block; }
    .form-input, .form-select {
      width: 100%; padding: 0.5rem 0.75rem; border: 1px solid hsl(var(--input));
      border-radius: var(--radius); font-size: 0.875rem; background: hsl(var(--background));
      color: hsl(var(--foreground)); outline: none; font-family: inherit;
    }
    .form-input:focus, .form-select:focus {
      border-color: hsl(var(--ring)); box-shadow: 0 0 0 2px hsla(var(--ring), 0.18);
    }

    .table-wrapper { overflow-x: auto; }
    table { width: 100%; border-collapse: collapse; text-align: left; font-size: 0.875rem; }
    th {
      padding: 0.85rem 1rem; font-weight: 600; font-size: 0.75rem;
      text-transform: uppercase; letter-spacing: 0.04em;
      color: hsl(var(--muted-foreground)); background: hsl(var(--muted) / 0.45);
      border-bottom: 1px solid hsl(var(--border)); white-space: nowrap;
    }
    td {
      padding: 0.9rem 1rem; border-bottom: 1px solid hsl(var(--border)); vertical-align: middle;
    }
    tr:hover td { background: hsl(var(--muted) / 0.25); }

    .modal-backdrop {
      position: fixed; inset: 0; background: rgba(15, 23, 42, 0.55);
      backdrop-filter: blur(2px); display: none; align-items: center; justify-content: center;
      z-index: 120; padding: 1rem;
    }
    .modal-backdrop.open { display: flex; }
    .modal-box {
      background: hsl(var(--background)); border: 1px solid hsl(var(--border));
      border-radius: 12px; width: 100%; max-width: 820px; max-height: 90vh;
      display: flex; flex-direction: column; overflow: hidden;
      box-shadow: 0 25px 50px -12px rgba(0,0,0,0.25);
    }
    .modal-header {
      padding: 1.25rem 1.5rem; border-bottom: 1px solid hsl(var(--border));
      display: flex; align-items: center; justify-content: space-between;
    }
    .modal-body {
      padding: 1.5rem; overflow-y: auto; display: flex; flex-direction: column; gap: 1.15rem;
    }
    .modal-footer {
      padding: 1rem 1.5rem; border-top: 1px solid hsl(var(--border));
      display: flex; align-items: center; justify-content: flex-end; gap: 0.75rem;
      flex-wrap: wrap; background: hsl(var(--muted) / 0.3);
    }

    .detail-section {
      border: 1px solid hsl(var(--border)); border-radius: 10px; padding: 1rem 1.25rem;
    }
    .detail-section h4 {
      font-size: 0.78rem; font-weight: 700; text-transform: uppercase; letter-spacing: 0.05em;
      color: hsl(var(--muted-foreground)); margin-bottom: 0.75rem;
    }
    .detail-grid {
      display: grid; grid-template-columns: repeat(3, 1fr); gap: 0.75rem 1rem;
    }
    @media (max-width: 640px) { .detail-grid { grid-template-columns: 1fr; } }
    .detail-item .lbl { font-size: 0.72rem; color: hsl(var(--muted-foreground)); }
    .detail-item .val { font-size: 0.875rem; font-weight: 600; color: hsl(var(--foreground)); word-break: break-word; }

    .reason-chip {
      padding: 0.35rem 0.7rem; border-radius: 999px; font-size: 0.75rem; font-weight: 500;
      border: 1px solid hsl(var(--border)); background: hsl(var(--muted) / 0.5);
      cursor: pointer; transition: all 0.15s;
    }
    .reason-chip:hover { background: #fee2e2; border-color: #fca5a5; color: #991b1b; }

    .toast-container {
      position: fixed; bottom: 1.5rem; right: 1.5rem; z-index: 200;
      display: flex; flex-direction: column; gap: 0.5rem; max-width: 420px;
    }
    .toast {
      background: #0f172a; color: #fff; padding: 0.9rem 1.15rem; border-radius: 10px;
      font-size: 0.85rem; box-shadow: 0 10px 25px rgba(0,0,0,0.2);
      display: flex; flex-direction: column; gap: 0.35rem;
    }
  </style>
</head>
<body>

<div class="app-container">
  <aside class="sidebar" id="sidebar">
    <div class="sidebar-header">
      <div class="sidebar-logo"></div>
      <span class="sidebar-title">Happy Deliveries</span>
    </div>
    <nav class="sidebar-content">
      <ul class="sidebar-menu">
        <li>
          <a href="/manager/dashboard" class="sidebar-menu-item">
            <svg xmlns="http://www.w3.org/2000/svg" width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><rect width="7" height="9" x="3" y="3" rx="1"/><rect width="7" height="5" x="14" y="3" rx="1"/><rect width="7" height="9" x="14" y="12" rx="1"/><rect width="7" height="5" x="3" y="16" rx="1"/></svg>
            <span>Dashboard</span>
          </a>
        </li>
        <li>
          <a href="/manager/restaurants" class="sidebar-menu-item">
            <svg xmlns="http://www.w3.org/2000/svg" width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M15 21v-5a1 1 0 0 0-1-1h-4a1 1 0 0 0-1 1v5"/><path d="M17.774 10.31a1.12 1.12 0 0 0-1.549 0 2.5 2.5 0 0 1-3.451 0 1.12 1.12 0 0 0-1.548 0 2.5 2.5 0 0 1-3.452 0 1.12 1.12 0 0 0-1.549 0 2.5 2.5 0 0 1-3.77-3.248l2.889-4.184A2 2 0 0 1 7 2h10a2 2 0 0 1 1.653.873l2.895 4.192a2.5 2.5 0 0 1-3.774 3.244"/><path d="M4 10.95V19a2 2 0 0 0 2 2h12a2 2 0 0 0 2-2v-8.05"/></svg>
            <span>Restaurants</span>
          </a>
        </li>
        <li>
          <a href="/manager/manage-restaurants" class="sidebar-menu-item active">
            <svg xmlns="http://www.w3.org/2000/svg" width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M16 21v-2a4 4 0 0 0-4-4H6a4 4 0 0 0-4 4v2"/><circle cx="9" cy="7" r="4"/><path d="M22 21v-2a4 4 0 0 0-3-3.87"/><path d="M16 3.13a4 4 0 0 1 0 7.75"/></svg>
            <span>Manage Restaurants</span>
          </a>
        </li>
        <li>
          <a href="/manager/menus" class="sidebar-menu-item">
            <svg xmlns="http://www.w3.org/2000/svg" width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="m16 2-2.3 2.3a3 3 0 0 0 0 4.2l1.8 1.8a3 3 0 0 0 4.2 0L22 8"/><path d="M15 15 3.3 3.3a4.2 4.2 0 0 0 0 6l7.3 7.3c.7.7 2 .7 2.8 0L15 15Zm0 0 7 7"/><path d="m2.1 21.8 6.4-6.3"/><path d="m19 5-7 7"/></svg>
            <span>Menus</span>
          </a>
        </li>
        <li>
          <a href="/manager/orders" class="sidebar-menu-item">
            <svg xmlns="http://www.w3.org/2000/svg" width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M13 16H8"/><path d="M14 8H8"/><path d="M16 12H8"/><path d="M4 3a1 1 0 0 1 1-1 1.3 1.3 0 0 1 .7.2l.933.6a1.3 1.3 0 0 0 1.4 0l.934-.6a1.3 1.3 0 0 1 1.4 0l.933.6a1.3 1.3 0 0 0 1.4 0l.933-.6a1.3 1.3 0 0 1 1.4 0l.934.6a1.3 1.3 0 0 0 1.4 0l.933-.6A1.3 1.3 0 0 1 19 2a1 1 0 0 1 1 1v18a1 1 0 0 1-1 1 1.3 1.3 0 0 1-.7-.2l-.933-.6a1.3 1.3 0 0 0-1.4 0l-.934.6a1.3 1.3 0 0 1-1.4 0l-.933-.6a1.3 1.3 0 0 0-1.4 0l-.933.6a1.3 1.3 0 0 1-1.4 0l-.934-.6a1.3 1.3 0 0 0-1.4 0l-.933.6a1.3 1.3 0 0 1-.7.2 1 1 0 0 1-1-1z"/></svg>
            <span>Orders</span>
          </a>
        </li>
        <li>
          <a href="/manager/drivers" class="sidebar-menu-item">
            <svg xmlns="http://www.w3.org/2000/svg" width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M19 17h2c.6 0 1-.4 1-1v-3c0-.9-.7-1.7-1.5-1.9C18.7 10.6 16 10 16 10s-1.3-1.4-2.2-2.3c-.5-.4-1.1-.7-1.8-.7H5c-.6 0-1.1.4-1.4.9l-1.4 2.9A3.7 3.7 0 0 0 2 12v4c0 .6.4 1 1 1h2"/><circle cx="7" cy="17" r="2"/><path d="M9 17h6"/><circle cx="17" cy="17" r="2"/></svg>
            <span>Manage Drivers</span>
          </a>
        </li>
        <li>
          <a href="/manager/analytics" class="sidebar-menu-item">
            <svg xmlns="http://www.w3.org/2000/svg" width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M3 3v18h18"/><path d="M18 17V9"/><path d="M13 17V5"/><path d="M8 17v-3"/></svg>
            <span>Analytics</span>
          </a>
        </li>
        <li>
          <a href="/manager/settings" class="sidebar-menu-item">
            <svg xmlns="http://www.w3.org/2000/svg" width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M12.22 2h-.44a2 2 0 0 0-2 2v.18a2 2 0 0 1-1 1.73l-.43.25a2 2 0 0 1-2 0l-.15-.08a2 2 0 0 0-2.73.73l-.22.38a2 2 0 0 0 .73 2.73l.15.1a2 2 0 0 1 1 1.72v.51a2 2 0 0 1-1 1.74l-.15.09a2 2 0 0 0-.73 2.73l.22.38a2 2 0 0 0 2.73.73l.15-.08a2 2 0 0 1 2 0l.43.25a2 2 0 0 1 1 1.73V20a2 2 0 0 0 2 2h.44a2 2 0 0 0 2-2v-.18a2 2 0 0 1 1-1.73l.43-.25a2 2 0 0 1 2 0l.15.08a2 2 0 0 0 2.73-.73l.22-.39a2 2 0 0 0-.73-2.73l-.15-.08a2 2 0 0 1-1-1.74v-.5a2 2 0 0 1 1-1.74l.15-.09a2 2 0 0 0 .73-2.73l-.22-.38a2 2 0 0 0-2.73-.73l-.15.08a2 2 0 0 1-2 0l-.43-.25a2 2 0 0 1-1-1.73V4a2 2 0 0 0-2-2z"/><circle cx="12" cy="12" r="3"/></svg>
            <span>Settings</span>
          </a>
        </li>
      </ul>
    </nav>
    <div class="sidebar-footer">
      <div class="sidebar-user">
        <div class="avatar"><%= manager.first_name ? manager.first_name[0] : 'M' %><%= manager.last_name ? manager.last_name[0] : '' %></div>
        <div class="sidebar-user-info">
          <span class="sidebar-user-name"><%= manager.first_name || 'Manager' %> <%= manager.last_name || '' %></span>
          <span class="sidebar-user-role">Happy Platform Admin</span>
        </div>
      </div>
    </div>
  </aside>

  <main class="main-content">
    <div class="topbar">
      <div class="topbar-search">
        <div class="search-input-wrapper">
          <svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><circle cx="11" cy="11" r="8"/><path d="m21 21-4.3-4.3"/></svg>
          <input type="text" class="search-input" id="topSearchInput" placeholder="Search restaurants, owners, email, address..." oninput="syncSearch(this.value)">
        </div>
      </div>
      <div class="topbar-actions">
        <button class="btn btn-outline btn-sm" onclick="copyPortalLink('/restaurant/register', 'Restaurant Registration Link Copied!')">
          <svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><rect width="14" height="14" x="8" y="8" rx="2" ry="2"/><path d="M4 16c-1.1 0-2-.9-2-2V4c0-1.1.9-2 2-2h10c1.1 0 2 .9 2 2"/></svg>
          Copy Partner Signup Link
        </button>
        <a href="/restaurant/login" target="_blank" class="btn btn-outline btn-sm">
          Partner Login Portal ↗
        </a>
        <a href="/manager/logout" class="btn btn-ghost btn-sm">Log out</a>
      </div>
    </div>

    <div class="page-container">
      <div class="page-header">
        <div>
          <h1 class="page-title">Manage Restaurants</h1>
          <p class="text-muted" style="font-size:0.875rem;">Review self-registered restaurant applications, approve or reject partners, and manage all active restaurants.</p>
        </div>
        <div class="page-actions">
          <a href="/manager/restaurants/add" class="btn btn-outline">+ Add Restaurant Directly</a>
          <button class="btn btn-primary" onclick="loadRestaurants()">
            <svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M21 12a9 9 0 1 1-9-9c2.52 0 4.93 1 6.74 2.74L21 8"/><path d="M21 3v5h-5"/></svg>
            Refresh
          </button>
        </div>
      </div>

      <div class="grid-5">
        <div class="card stat-card" style="cursor:pointer;" onclick="filterByStatusCard('all')">
          <div class="card-header"><span class="card-title">Total Restaurants</span></div>
          <div class="card-content">
            <div class="stat-value" id="statTotal">0</div>
            <p class="stat-description">Platform & partner stores</p>
          </div>
        </div>
        <div class="card stat-card" style="cursor:pointer;border-left:4px solid #f59e0b;" onclick="filterByStatusCard('pending')">
          <div class="card-header"><span class="card-title">Pending Review</span></div>
          <div class="card-content">
            <div class="stat-value" id="statPending" style="color:#d97706;">0</div>
            <p class="stat-description">Awaiting Happy approval</p>
          </div>
        </div>
        <div class="card stat-card" style="cursor:pointer;border-left:4px solid #16a34a;" onclick="filterByStatusCard('approved')">
          <div class="card-header"><span class="card-title">Approved Stores</span></div>
          <div class="card-content">
            <div class="stat-value" id="statApproved" style="color:#16a34a;">0</div>
            <p class="stat-description">Partner portal enabled</p>
          </div>
        </div>
        <div class="card stat-card" style="cursor:pointer;border-left:4px solid #dc2626;" onclick="filterByStatusCard('rejected')">
          <div class="card-header"><span class="card-title">Rejected</span></div>
          <div class="card-content">
            <div class="stat-value" id="statRejected" style="color:#dc2626;">0</div>
            <p class="stat-description">Feedback emailed to owner</p>
          </div>
        </div>
        <div class="card stat-card" style="cursor:pointer;border-left:4px solid #2563eb;" onclick="filterByStatusCard('approved')">
          <div class="card-header"><span class="card-title">Live Accepting Orders</span></div>
          <div class="card-content">
            <div class="stat-value" id="statActive" style="color:#2563eb;">0</div>
            <p class="stat-description">Visible to customers now</p>
          </div>
        </div>
      </div>

      <div class="filters-card">
        <div class="filter-group" style="flex:2;">
          <label class="filter-label">Search Restaurant / Owner / Email / Address</label>
          <input type="text" class="form-input" id="filterSearch" placeholder="Restaurant name, owner, email, phone, cuisine, reg #..." oninput="debounceLoadRestaurants()">
        </div>
        <div class="filter-group">
          <label class="filter-label">Approval Status</label>
          <select class="form-select" id="filterStatus" onchange="loadRestaurants()">
            <option value="all">All Statuses</option>
            <option value="pending">Pending Review</option>
            <option value="approved">Approved</option>
            <option value="rejected">Rejected</option>
          </select>
        </div>
        <div class="filter-group">
          <label class="filter-label">Onboarding Source</label>
          <select class="form-select" id="filterSource" onchange="loadRestaurants()">
            <option value="all">All Sources</option>
            <option value="self_registered">Partner Self-Registered</option>
            <option value="admin">Happy Admin Added</option>
          </select>
        </div>
        <button class="btn btn-outline" onclick="resetFilters()">Reset</button>
      </div>

      <div class="card">
        <div class="card-header" style="flex-direction:row;align-items:center;justify-content:space-between;">
          <div>
            <div class="card-title">Restaurant Applications & Partner Stores</div>
            <div style="font-size:0.8rem;color:hsl(var(--muted-foreground));" id="tableCountLabel">Loading restaurants...</div>
          </div>
        </div>
        <div class="card-content-full table-wrapper">
          <table>
            <thead>
              <tr>
                <th>Restaurant</th>
                <th>Owner & Contact</th>
                <th>Location & Ops</th>
                <th>Catalog & Orders</th>
                <th>Approval / Live Status</th>
                <th>Submitted</th>
                <th style="text-align:right;">Actions</th>
              </tr>
            </thead>
            <tbody id="restaurantsTableBody">
              <tr>
                <td colspan="7" style="text-align:center;padding:2.5rem;color:hsl(var(--muted-foreground));">
                  Loading restaurant applications...
                </td>
              </tr>
            </tbody>
          </table>
        </div>
      </div>
    </div>
  </main>
</div>

<!-- FULL RESTAURANT APPLICATION DOSSIER MODAL -->
<div class="modal-backdrop" id="restaurantDetailModal">
  <div class="modal-box">
    <div class="modal-header">
      <div>
        <h3 style="font-size:1.15rem;font-weight:700;" id="modalRestName">Restaurant Details</h3>
        <p style="font-size:0.8rem;color:hsl(var(--muted-foreground));" id="modalRestSub">Partner registration & operational dossier</p>
      </div>
      <button class="btn btn-ghost btn-sm" onclick="closeDetailModal()">✕</button>
    </div>
    <div class="modal-body" id="modalRestBody"></div>
    <div class="modal-footer" id="modalRestFooter"></div>
  </div>
</div>

<!-- REJECT APPLICATION & EMAIL FEEDBACK MODAL -->
<div class="modal-backdrop" id="rejectRestaurantModal">
  <div class="modal-box" style="max-width:560px;">
    <div class="modal-header">
      <div>
        <h3 style="font-size:1.1rem;font-weight:700;color:#dc2626;">Reject Restaurant Application & Email Owner</h3>
        <p style="font-size:0.8rem;color:hsl(var(--muted-foreground));" id="rejectModalSub">Explain what needs to be updated before approval.</p>
      </div>
      <button class="btn btn-ghost btn-sm" onclick="closeRejectModal()">✕</button>
    </div>
    <div class="modal-body">
      <div>
        <label class="filter-label" style="display:block;margin-bottom:0.4rem;">Quick Issue Templates (Click to insert)</label>
        <div style="display:flex;flex-wrap:wrap;gap:0.4rem;">
          <button type="button" class="reason-chip" onclick="appendRejectReason('Restaurant street address or GPS coordinates could not be verified.')">Address / GPS mismatch</button>
          <button type="button" class="reason-chip" onclick="appendRejectReason('Business registration number or owner ID details need clarification.')">Business / ID details incomplete</button>
          <button type="button" class="reason-chip" onclick="appendRejectReason('Bank account payout details are missing or could not be verified.')">Banking details incomplete</button>
          <button type="button" class="reason-chip" onclick="appendRejectReason('Restaurant contact phone or email could not be reached for verification.')">Contact verification issue</button>
          <button type="button" class="reason-chip" onclick="appendRejectReason('Delivery radius or operating zone falls outside our active service area.')">Outside service area</button>
        </div>
      </div>

      <div>
        <label class="filter-label" style="display:block;margin-bottom:0.4rem;">Detailed Message to Restaurant Owner (Sent via Email) *</label>
        <textarea id="rejectReasonInput" rows="5" class="form-input" style="resize:vertical;" placeholder="Explain clearly what needs to be fixed before resubmitting..."></textarea>
      </div>
    </div>
    <div class="modal-footer">
      <button class="btn btn-outline" onclick="closeRejectModal()">Cancel</button>
      <button class="btn btn-danger" id="confirmRejectBtn" onclick="confirmRejectRestaurant()">
        Reject Application & Send Email
      </button>
    </div>
  </div>
</div>

<div class="toast-container" id="toastContainer"></div>

<script src="/socket.io/socket.io.js"></script>
<script>
  let allRestaurants = [];
  let selectedRestaurantId = null;
  let searchDebounce = null;

  function esc(val) {
    if (val === null || val === undefined) return '';
    return String(val).replace(/[&<>"']/g, (c) => ({ '&': '&amp;', '<': '&lt;', '>': '&gt;', '"': '&quot;', "'": '&#39;' }[c]));
  }

  function showToast(title, subtitle, mailtoUrl) {
    const container = document.getElementById('toastContainer');
    const el = document.createElement('div');
    el.className = 'toast';
    el.innerHTML = `
      <div style="font-weight:700;">${esc(title)}</div>
      ${subtitle ? `<div style="font-size:0.78rem;color:#cbd5e1;">${esc(subtitle)}</div>` : ''}
      ${mailtoUrl ? `<a href="${esc(mailtoUrl)}" style="margin-top:4px;color:#fb923c;font-size:0.78rem;font-weight:600;text-decoration:underline;">Open in Default Email App ↗</a>` : ''}
    `;
    container.appendChild(el);
    setTimeout(() => el.remove(), 7000);
  }

  function copyPortalLink(path, msg) {
    const url = window.location.origin + path;
    navigator.clipboard?.writeText(url);
    showToast(msg, url);
  }

  function syncSearch(val) {
    document.getElementById('filterSearch').value = val;
    debounceLoadRestaurants();
  }

  function debounceLoadRestaurants() {
    clearTimeout(searchDebounce);
    searchDebounce = setTimeout(loadRestaurants, 250);
  }

  function filterByStatusCard(status) {
    document.getElementById('filterStatus').value = status;
    loadRestaurants();
  }

  function resetFilters() {
    document.getElementById('filterSearch').value = '';
    document.getElementById('topSearchInput').value = '';
    document.getElementById('filterStatus').value = 'all';
    document.getElementById('filterSource').value = 'all';
    loadRestaurants();
  }

  function renderStatusBadge(r) {
    const st = r.approval_status || 'approved';
    if (st === 'approved') return '<span class="badge badge-green">Approved</span>';
    if (st === 'rejected') return '<span class="badge badge-red">Rejected</span>';
    return '<span class="badge badge-yellow">Pending Review</span>';
  }

  function fmtDate(d) {
    if (!d) return '—';
    return new Date(d).toLocaleDateString('en-ZA', { year: 'numeric', month: 'short', day: 'numeric' });
  }

  async function loadRestaurants() {
    const search = document.getElementById('filterSearch').value.trim();
    const status = document.getElementById('filterStatus').value;
    const source = document.getElementById('filterSource').value;

    const params = new URLSearchParams({ status, source });
    if (search) params.set('search', search);

    try {
      const res = await fetch('/manager/api/manage-restaurants?' + params.toString());
      const data = await res.json();
      if (!data.success) throw new Error(data.error || 'Failed to load');

      allRestaurants = data.restaurants || [];
      const stats = data.stats || {};
      document.getElementById('statTotal').textContent = stats.total || 0;
      document.getElementById('statPending').textContent = stats.pending || 0;
      document.getElementById('statApproved').textContent = stats.approved || 0;
      document.getElementById('statRejected').textContent = stats.rejected || 0;
      document.getElementById('statActive').textContent = stats.accepting_orders || 0;

      renderTable(allRestaurants);
    } catch (err) {
      document.getElementById('restaurantsTableBody').innerHTML =
        `<tr><td colspan="7" style="text-align:center;color:#dc2626;padding:2rem;">${esc(err.message)}</td></tr>`;
    }
  }

  function renderTable(list) {
    const tbody = document.getElementById('restaurantsTableBody');
    document.getElementById('tableCountLabel').textContent = `Showing ${list.length} restaurant${list.length === 1 ? '' : 's'}`;

    if (!list.length) {
      tbody.innerHTML = '<tr><td colspan="7" style="text-align:center;padding:2.5rem;color:hsl(var(--muted-foreground));">No restaurants match these filters.</td></tr>';
      return;
    }

    tbody.innerHTML = list.map((r) => {
      const sourceBadge = r.registration_source === 'self_registered'
        ? '<span class="badge badge-blue">Partner Self-Reg</span>'
        : '<span class="badge badge-gray">Platform Added</span>';
      const activeChip = r.is_active
        ? `<span class="badge badge-green">${r.is_accepting_orders ? 'Live & Open' : 'Active (Paused)'}</span>`
        : '<span class="badge badge-gray">Hidden</span>';

      return `
        <tr>
          <td>
            <div style="display:flex;align-items:center;gap:0.75rem;">
              <div class="avatar">
                ${r.logo_url ? `<img src="${esc(r.logo_url)}" alt="${esc(r.name)}" onerror="this.remove()">` : esc((r.name || 'R')[0].toUpperCase())}
              </div>
              <div>
                <div style="font-weight:600;">${esc(r.name)}</div>
                <div style="font-size:0.76rem;color:hsl(var(--muted-foreground));">${esc(r.cuisine_type || 'General')}</div>
                <div style="margin-top:3px;">${sourceBadge}</div>
              </div>
            </div>
          </td>
          <td>
            <div style="font-weight:500;">${esc(r.owner_first_name || '')} ${esc(r.owner_last_name || '')}</div>
            <div style="font-size:0.78rem;color:hsl(var(--muted-foreground));">${esc(r.owner_email || r.email || '—')}</div>
            <div style="font-size:0.78rem;">${esc(r.phone_number || r.owner_phone || '—')}</div>
          </td>
          <td>
            <div style="max-width:210px;white-space:nowrap;overflow:hidden;text-overflow:ellipsis;" title="${esc(r.address)}">${esc(r.address || '—')}</div>
            <div style="font-size:0.76rem;color:hsl(var(--muted-foreground));">Radius: ${r.delivery_radius_km || 5}km · Prep: ${r.preparation_time_minutes || 20}m</div>
          </td>
          <td>
            <div style="font-weight:600;">${r.menu_count || 0} menus · ${r.item_count || 0} items</div>
            <div style="font-size:0.76rem;color:hsl(var(--muted-foreground));">${r.orders_count || 0} orders · R${parseFloat(r.delivered_revenue || 0).toFixed(2)}</div>
          </td>
          <td>
            <div style="display:flex;flex-direction:column;gap:4px;align-items:flex-start;">
              ${renderStatusBadge(r)}
              ${activeChip}
            </div>
          </td>
          <td style="font-size:0.8rem;color:hsl(var(--muted-foreground));">${fmtDate(r.created_at)}</td>
          <td style="text-align:right;">
            <div style="display:inline-flex;gap:0.35rem;flex-wrap:wrap;justify-content:flex-end;">
              <button class="btn btn-outline btn-sm" onclick="openDetailModal('${r.id}')">Review</button>
              ${r.approval_status !== 'approved' ? `<button class="btn btn-success btn-sm" onclick="approveRestaurant('${r.id}')">Approve</button>` : ''}
              ${r.approval_status !== 'rejected' ? `<button class="btn btn-danger btn-sm" onclick="openRejectModal('${r.id}')">Reject</button>` : ''}
              <a class="btn btn-outline btn-sm" href="/manager/restaurants/edit/${r.id}">Edit</a>
            </div>
          </td>
        </tr>
      `;
    }).join('');
  }

  async function openDetailModal(id) {
    selectedRestaurantId = id;
    document.getElementById('modalRestBody').innerHTML = '<div style="padding:2rem;text-align:center;">Loading full dossier...</div>';
    document.getElementById('modalRestFooter').innerHTML = '';
    document.getElementById('restaurantDetailModal').classList.add('open');

    try {
      const res = await fetch(`/manager/api/manage-restaurants/${id}`);
      const data = await res.json();
      if (!data.success) throw new Error(data.error || 'Not found');

      const r = data.restaurant;
      const menus = data.menus || [];
      const app = r.application_details || {};

      document.getElementById('modalRestName').textContent = r.name;
      document.getElementById('modalRestSub').textContent = `${r.cuisine_type || 'General'} · Submitted ${fmtDate(r.created_at)}`;

      document.getElementById('modalRestBody').innerHTML = `
        <div style="display:flex;align-items:center;justify-content:space-between;flex-wrap:wrap;gap:0.75rem;">
          <div style="display:flex;gap:0.5rem;align-items:center;">
            ${renderStatusBadge(r)}
            <span class="badge badge-gray">${r.registration_source === 'self_registered' ? 'Self-Registered Partner' : 'Platform Created'}</span>
            <span class="badge ${r.is_active ? 'badge-green' : 'badge-gray'}">${r.is_active ? 'Active on App' : 'Hidden'}</span>
          </div>
          <div style="font-size:0.8rem;color:hsl(var(--muted-foreground));">
            Opening Hours: <strong>${esc(r.opening_hours_display || '08:00 - 21:00')}</strong>
          </div>
        </div>

        ${r.rejection_reason ? `
          <div style="background:#fef2f2;border-left:4px solid #dc2626;padding:0.9rem 1rem;border-radius:6px;color:#7f1d1d;">
            <strong>Current Rejection Reason:</strong>
            <div style="margin-top:4px;font-size:0.85rem;white-space:pre-line;">${esc(r.rejection_reason)}</div>
          </div>
        ` : ''}

        <div class="detail-section">
          <h4>1. Restaurant Information</h4>
          <div class="detail-grid">
            <div class="detail-item"><div class="lbl">Restaurant Name</div><div class="val">${esc(r.name)}</div></div>
            <div class="detail-item"><div class="lbl">Store Phone</div><div class="val">${esc(r.phone_number || '—')}</div></div>
            <div class="detail-item"><div class="lbl">Store Email</div><div class="val">${esc(r.email || '—')}</div></div>
            <div class="detail-item"><div class="lbl">Cuisine Types</div><div class="val">${esc(r.cuisine_type || '—')}</div></div>
            <div class="detail-item"><div class="lbl">Prep Time</div><div class="val">${r.preparation_time_minutes || 20} mins</div></div>
            <div class="detail-item"><div class="lbl">Delivery Radius</div><div class="val">${r.delivery_radius_km || 5} km</div></div>
          </div>
          ${r.description ? `<p style="margin-top:0.75rem;font-size:0.85rem;color:hsl(var(--muted-foreground));">${esc(r.description)}</p>` : ''}
        </div>

        <div class="detail-section">
          <h4>2. Owner & Business Compliance</h4>
          <div class="detail-grid">
            <div class="detail-item"><div class="lbl">Owner / Representative</div><div class="val">${esc(r.owner_first_name || app.owner_first_name || '—')} ${esc(r.owner_last_name || app.owner_last_name || '')}</div></div>
            <div class="detail-item"><div class="lbl">Login Email</div><div class="val">${esc(r.owner_email || app.owner_email || '—')}</div></div>
            <div class="detail-item"><div class="lbl">Owner Phone</div><div class="val">${esc(r.owner_phone || app.owner_phone || '—')}</div></div>
            <div class="detail-item"><div class="lbl">Owner ID / Passport #</div><div class="val">${esc(app.owner_id_number || '—')}</div></div>
            <div class="detail-item"><div class="lbl">Business Reg #</div><div class="val">${esc(app.business_registration_number || '—')}</div></div>
            <div class="detail-item"><div class="lbl">VAT Number</div><div class="val">${esc(app.vat_number || '—')}</div></div>
          </div>
        </div>

        <div class="detail-section">
          <h4>3. Location & Address</h4>
          <div style="font-size:0.88rem;font-weight:600;margin-bottom:0.5rem;">${esc(r.address)}</div>
          <div style="font-size:0.8rem;color:hsl(var(--muted-foreground));margin-bottom:0.65rem;">
            City: ${esc(app.city || '—')} · Postal Code: ${esc(app.postal_code || '—')} · GPS: ${r.lat ?? '—'}, ${r.lng ?? '—'}
          </div>
          ${r.lat && r.lng ? `
            <iframe width="100%" height="180" frameborder="0" style="border-radius:8px;border:1px solid hsl(var(--border));"
              src="https://maps.google.com/maps?q=${r.lat},${r.lng}&z=15&output=embed"></iframe>
          ` : ''}
        </div>

        <div class="detail-section">
          <h4>4. Banking & Payout Details</h4>
          <div class="detail-grid">
            <div class="detail-item"><div class="lbl">Bank Name</div><div class="val">${esc(app.bank_name || '—')}</div></div>
            <div class="detail-item"><div class="lbl">Account Holder</div><div class="val">${esc(app.account_holder_name || '—')}</div></div>
            <div class="detail-item"><div class="lbl">Account Number</div><div class="val">${esc(app.account_number || '—')}</div></div>
            <div class="detail-item"><div class="lbl">Branch Code</div><div class="val">${esc(app.branch_code || '—')}</div></div>
            <div class="detail-item"><div class="lbl">Account Type</div><div class="val">${esc(app.account_type || '—')}</div></div>
            <div class="detail-item"><div class="lbl">Applicant Notes</div><div class="val">${esc(app.applicant_notes || '—')}</div></div>
          </div>
        </div>

        <div class="detail-section">
          <h4>5. Menus & Activity Summary</h4>
          <div style="display:flex;gap:1.5rem;flex-wrap:wrap;margin-bottom:0.65rem;font-size:0.85rem;">
            <span>Menus: <strong>${menus.length}</strong></span>
            <span>Menu Items: <strong>${r.item_count || 0}</strong></span>
            <span>Total Orders: <strong>${r.orders_count || 0}</strong></span>
            <span>Delivered Revenue: <strong>R${parseFloat(r.delivered_revenue || 0).toFixed(2)}</strong></span>
          </div>
          ${menus.length ? menus.map(m => `<span class="badge badge-gray" style="margin:2px;">${esc(m.name)} (${m.item_count} items)</span>`).join('') : '<span style="font-size:0.82rem;color:hsl(var(--muted-foreground));">No menus added yet (partner can add menus after approval, or admin can add on Menus page).</span>'}
        </div>
      `;

      document.getElementById('modalRestFooter').innerHTML = `
        <a href="/manager/restaurants/edit/${r.id}" class="btn btn-outline">Edit Store Info</a>
        <a href="/manager/menus" class="btn btn-outline">Open Menus</a>
        ${r.approval_status !== 'rejected' ? `<button class="btn btn-danger" onclick="openRejectModal('${r.id}')">Reject & Email</button>` : ''}
        ${r.approval_status !== 'approved' ? `<button class="btn btn-success" onclick="approveRestaurant('${r.id}')">Approve & Activate</button>` : ''}
        <button class="btn btn-ghost" onclick="closeDetailModal()">Close</button>
      `;
    } catch (err) {
      document.getElementById('modalRestBody').innerHTML = `<div style="color:#dc2626;padding:1.5rem;">${esc(err.message)}</div>`;
    }
  }

  function closeDetailModal() {
    document.getElementById('restaurantDetailModal').classList.remove('open');
  }

  async function approveRestaurant(id) {
    const notes = prompt('Optional approval welcome note to email to the restaurant owner (leave blank for default):') || '';
    try {
      const res = await fetch(`/manager/api/manage-restaurants/${id}/approve`, {
        method: 'POST',
        headers: { 'Content-Type': 'application/json' },
        body: JSON.stringify({ notes }),
      });
      const data = await res.json();
      if (!data.success) throw new Error(data.error || 'Approval failed');

      closeDetailModal();
      showToast('Restaurant Approved!', data.message, data.emailResult?.mailtoUrl);
      loadRestaurants();
    } catch (err) {
      showToast('Approval Error', err.message);
    }
  }

  function openRejectModal(id) {
    selectedRestaurantId = id;
    document.getElementById('rejectReasonInput').value = '';
    document.getElementById('rejectRestaurantModal').classList.add('open');
  }

  function closeRejectModal() {
    document.getElementById('rejectRestaurantModal').classList.remove('open');
  }

  function appendRejectReason(text) {
    const el = document.getElementById('rejectReasonInput');
    el.value = el.value.trim() ? `${el.value.trim()}\n• ${text}` : `• ${text}`;
    el.focus();
  }

  async function confirmRejectRestaurant() {
    const reason = document.getElementById('rejectReasonInput').value.trim();
    if (!reason) {
      alert('Please enter a reason so the restaurant owner knows what to correct.');
      return;
    }

    const btn = document.getElementById('confirmRejectBtn');
    btn.disabled = true;
    btn.textContent = 'Rejecting & Sending Email...';

    try {
      const res = await fetch(`/manager/api/manage-restaurants/${selectedRestaurantId}/reject`, {
        method: 'POST',
        headers: { 'Content-Type': 'application/json' },
        body: JSON.stringify({ reason }),
      });
      const data = await res.json();
      if (!data.success) throw new Error(data.error || 'Rejection failed');

      closeRejectModal();
      closeDetailModal();
      showToast('Application Rejected & Email Sent', data.message, data.emailResult?.mailtoUrl);
      loadRestaurants();
    } catch (err) {
      showToast('Rejection Error', err.message);
    } finally {
      btn.disabled = false;
      btn.textContent = 'Reject Application & Send Email';
    }
  }

  document.addEventListener('DOMContentLoaded', () => {
    loadRestaurants();
    if (typeof io !== 'undefined') {
      const socket = io();
      socket.on('connect', () => {
        socket.emit('join_manager_room', {});
      });
      socket.on('new_restaurant_application', (payload) => {
        showToast('New Restaurant Application', `${payload?.name || 'A restaurant'} submitted an onboarding application.`);
        loadRestaurants();
      });
      socket.on('restaurant_application_resubmitted', (payload) => {
        showToast('Restaurant Application Resubmitted', `${payload?.name || 'A restaurant'} updated and resubmitted its application.`);
        loadRestaurants();
      });
    }
  });
</script>
</body>
</html>
