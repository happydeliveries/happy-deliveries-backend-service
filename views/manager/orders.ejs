  window.managerId = "<%= manager.id || '' %>" || null;
  window.restaurantIds = <%- JSON.stringify((restaurants || []).map(r => r.id)) %>;
  window.SUPPORT_PHONE = <%- JSON.stringify((supportContact && supportContact.support_phone) || '') %>;
  window.SUPPORT_NAME = <%- JSON.stringify((supportContact && supportContact.support_name) || 'Happy Deliveries Dispatch') %>;
</script>
<script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.0/dist/js/bootstrap.bundle.min.js"></script>
<script src="/socket.io/socket.io.js"></script>
<script src="/js/order-details.js"></script>
<script src="/js/manager.js"></script>
<script>
/* ═══════════════════════════════════════════════════════════════════════
   Happy Delivery — Orders Page (Dashboard-styled)
   API routes served by managerWeb.js
   ═══════════════════════════════════════════════════════════════════════ */

const API       = '/manager/api';
const PAGE_SIZE = 15;

let currentPage  = 1;
let totalPages   = 1;
let totalRecords = 0;
let autoTimer    = null;

const STATUS_BADGES = {
  pending:                'badge-yellow',
  accepted_by_driver:     'badge-blue',
  ordering_at_restaurant: 'badge-blue',
  order_ready:            'badge-green',
  picked_up:              'badge-gray',
  on_the_way:             'badge-blue',
  arrived:                'badge-blue',
  delivered:              'badge-green',
  cancelled:              'badge-red',
  no_drivers_available:   'badge-red',
  delivery_failed:        'badge-red',
};
const PAY_BADGES = {
  pending:    'badge-yellow',
  processing: 'badge-blue',
  completed:  'badge-green',
  failed:     'badge-red',
  refunded:   'badge-gray',
};

// ── Init ──────────────────────────────────────────────────────────────
function updateLiveBadgeStatus(connected) {
  const txt = document.getElementById('liveStatusText');
  if (txt) txt.textContent = connected ? 'Live (Socket.IO)' : 'Reconnecting…';
}

document.addEventListener('DOMContentLoaded', () => {
  document.getElementById('filterDate').value = '';
  loadStats();
  loadOrders(1);
});

// ── Stats strip ───────────────────────────────────────────────────────
async function loadStats() {
  try {
    const res  = await apiFetch(`${API}/orders/stats`);
    const data = await res.json();
    if (!data.success) return;

    const { active, pending, revenue, total_today } = data.stats;
    setText('statActive',  active       ?? 0);
    setText('statPending', pending      ?? 0);
    setText('statRevenue', fmtNumber(revenue ?? 0));
    setText('statTotal',   total_today  ?? 0);

    const badge = document.getElementById('topbarBadge');
    if (active > 0) {
      badge.textContent = active;
      badge.style.display = '';
    } else {
      badge.style.display = 'none';
    }
  } catch (err) {
    console.warn('[loadStats]', err.message);
  }
}

// ── Orders list ───────────────────────────────────────────────────────
async function loadOrders(page = 1, silent = false) {
  currentPage = page;

  if (!silent) {
    document.getElementById('ordersBody').innerHTML = `
      <tr class="spinner-row">
        <td colspan="10" class="text-center">
          <div class="spinner"></div>
          <div style="margin-top:0.5rem; color:hsl(var(--muted-foreground)); font-size:0.85rem;">Loading orders…</div>
        </td>
      </tr>`;
    setText('tableMeta', 'Loading…');
  }

  const icon = document.getElementById('refreshIcon');
  icon.classList.add('spin');

  try {
    const restaurant = document.getElementById('filterRestaurant').value;
    const status     = document.getElementById('filterStatus').value;
    const date       = document.getElementById('filterDate').value;

    const params = new URLSearchParams({
      page, limit: PAGE_SIZE,
      restaurant: restaurant || 'all',
      status:     status     || 'all',
    });
    if (date) params.set('date', date);

    const res  = await apiFetch(`${API}/orders?${params}`);
    const data = await res.json();

    if (!data.success) throw new Error(data.error || 'Failed to load orders');

    totalPages   = data.totalPages   || 1;
    totalRecords = data.total        || 0;

    renderOrders(data.orders);
    renderPagination();

    const start = (page - 1) * PAGE_SIZE + 1;
    const end   = Math.min(start + (data.orders.length - 1), totalRecords);
    setText('tableMeta',
      totalRecords === 0
        ? 'No orders found'
        : `Showing ${start}–${end} of ${totalRecords} orders`
    );

  } catch (err) {
    console.error('[loadOrders]', err);
    document.getElementById('ordersBody').innerHTML = `
      <tr>
        <td colspan="10">
          <div class="empty-state">
            <svg xmlns="http://www.w3.org/2000/svg" width="48" height="48" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><circle cx="12" cy="12" r="10"/><line x1="12" x2="12" y1="8" y2="12"/><line x1="12" x2="12.01" y1="16" y2="16"/></svg>
            <h5>Could not load orders</h5>
            <p>${escHtml(err.message)}</p>
            <button class="btn btn-primary mt-4" onclick="loadOrders(1)">
              <svg xmlns="http://www.w3.org/2000/svg" width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M21 12a9 9 0 0 0-9-9 9.75 9.75 0 0 0-6.74 2.74L3 8"/><path d="M3 3v5h5"/><path d="M3 12a9 9 0 0 0 9 9 9.75 9.75 0 0 0 6.74-2.74L21 16"/><path d="M16 16h5v5"/></svg>
              Try again
            </button>
          </div>
        </td>
      </tr>`;
    setText('tableMeta', 'Error');
  } finally {
    icon.classList.remove('spin');
  }
}

function renderOrders(orders) {
  const tbody = document.getElementById('ordersBody');

  if (!orders.length) {
    tbody.innerHTML = `
      <tr>
        <td colspan="10">
          <div class="empty-state">
            <svg xmlns="http://www.w3.org/2000/svg" width="48" height="48" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M21 8a2 2 0 0 0-1-1.73l-7-4a2 2 0 0 0-2 0l-7 4A2 2 0 0 0 3 8v8a2 2 0 0 0 1 1.73l7 4a2 2 0 0 0 2 0l7-4A2 2 0 0 0 21 16Z"/><path d="m3.3 7 8.7 5 8.7-5"/><path d="M12 22V12"/></svg>
            <h5>No orders found</h5>
            <p>Try adjusting your filters or check back soon.</p>
          </div>
        </td>
      </tr>`;
    return;
  }

  OrderDetails.rememberOrders(orders);

  tbody.innerHTML = orders.map(o => {
    const timeAgo = relativeTime(o.placed_at);
    const timeStr = fmtTime(o.placed_at);
    const statusClass = STATUS_BADGES[o.status] || 'badge-gray';
    const payClass    = PAY_BADGES[o.payment_status] || 'badge-yellow';
    const driverVeh   = [o.driver_vehicle_color, o.driver_vehicle_model || o.driver_vehicle_type].filter(Boolean).join(' ');
    const rescueInfo  = typeof o.rescue_courier === 'string'
      ? (() => { try { return JSON.parse(o.rescue_courier); } catch { return null; } })()
      : o.rescue_courier;

    return `
    <tr>
      <td>
        <strong style="color:hsl(var(--primary))">#${escHtml(o.order_number || o.id.slice(0,8).toUpperCase())}</strong>
      </td>
      <td>
        <div style="font-weight:500">${escHtml(o.customer_name || 'Unknown')}</div>
      </td>
      <td>
        <div style="font-size:0.85rem;color:hsl(var(--muted-foreground))">${escHtml(o.restaurant_name || '—')}</div>
      </td>
      <td>
        ${rescueInfo?.name
          ? `<div style="font-weight:600;font-size:0.84rem;color:#047857">🛡️ ${escHtml(rescueInfo.name)}</div>
             <div style="font-size:0.74rem;color:#065f46">${escHtml(rescueInfo.courier_type_label || 'Happy Rescue')}</div>`
          : o.driver_name
            ? `<div style="font-weight:600;font-size:0.84rem;color:#1e40af">${escHtml(o.driver_name)}</div>
               <div style="font-size:0.74rem;color:hsl(var(--muted-foreground))">${escHtml(driverVeh)}${o.driver_vehicle_plate ? ` · ${escHtml(o.driver_vehicle_plate)}` : ''}</div>`
            : `<span style="font-size:0.78rem;color:hsl(var(--muted-foreground))">${o.reassigned_at && !['cancelled','delivered','delivery_failed'].includes(o.status) ? '🔄 Reassigning…' : 'Unassigned'}</span>`
        }
      </td>
      <td>
        ${OrderDetails.renderCompactItemsPreview(o.items, o.item_count)}
      </td>
      <td>
        <strong>R${fmtMoney(o.total_amount)}</strong>
      </td>
      <td>
        <span class="badge ${payClass}">${fmtPayStatus(o.payment_status)}</span>
      </td>
      <td>
        <span class="badge ${statusClass}">${fmtStatus(o.status, o.payment_status)}</span>
      </td>
      <td>
        <div style="font-size:0.85rem;font-weight:500">${timeStr}</div>
        <div style="font-size:0.75rem;color:hsl(var(--muted-foreground))">${timeAgo}</div>
      </td>
      <td>
        <div style="display:flex; gap:0.4rem; flex-wrap:wrap; align-items:center;">
          ${o.status === 'pending' ? `
            <button class="btn btn-success btn-sm" onclick="acceptOrder('${o.id}', this)">Accept</button>
            <button class="btn btn-danger btn-sm" onclick="rejectOrder('${o.id}', this)">Reject</button>
          ` : ''}
          <button class="btn btn-primary btn-sm" onclick="openOrder('${o.id}')">
            <svg xmlns="http://www.w3.org/2000/svg" width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M2 12s3-7 10-7 10 7 10 7-3 7-10 7-10-7-10-7Z"/><circle cx="12" cy="12" r="3"/></svg>
            View
          </button>
        </div>
      </td>
    </tr>`;
  }).join('');
}

// ── Pagination ────────────────────────────────────────────────────────
function renderPagination() {
  const nav = document.getElementById('pagination');
  const pi  = document.getElementById('pageInfo');

  pi.textContent = `Page ${currentPage} of ${totalPages}`;

  if (totalPages <= 1) { nav.innerHTML = ''; return; }

  const pages = [];

  // Prev
  pages.push(`
    <button class="btn btn-outline btn-sm" ${currentPage === 1 ? 'disabled' : ''} onclick="loadOrders(${currentPage - 1})">
      <svg xmlns="http://www.w3.org/2000/svg" width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="m15 18-6-6 6-6"/></svg>
    </button>`);

  // Window of 5
  const from = Math.max(1, currentPage - 2);
  const to   = Math.min(totalPages, currentPage + 2);

  if (from > 1) pages.push(`<<button class="btn btn-ghost btn-sm" disabled>…</button>`);

  for (let p = from; p <= to; p++) {
    pages.push(`
      <button class="btn ${p === currentPage ? 'btn-primary' : 'btn-outline'} btn-sm" onclick="loadOrders(${p})">
        ${p}
      </button>`);
  }

  if (to < totalPages) pages.push(`<<button class="btn btn-ghost btn-sm" disabled>…</button>`);

  // Next
  pages.push(`
    <button class="btn btn-outline btn-sm" ${currentPage === totalPages ? 'disabled' : ''} onclick="loadOrders(${currentPage + 1})">
      <svg xmlns="http://www.w3.org/2000/svg" width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="m9 18 6-6-6-6"/></svg>
    </button>`);

  nav.innerHTML = pages.join('');
}

// ── Order detail modal ────────────────────────────────────────────────
window.currentOpenOrderId = null;
window.reloadOpenOrderModal = (targetOrderId) => {
  if (!window.currentOpenOrderId) return;
  if (targetOrderId && String(targetOrderId) !== String(window.currentOpenOrderId)) return;
  const modal = document.getElementById('orderModal');
  if (modal && modal.classList.contains('active')) {
    openOrder(window.currentOpenOrderId, true);
  }
};

async function openOrder(orderId, silent = false) {
  window.currentOpenOrderId = orderId;
  if (!silent) {
    document.getElementById('orderModalBody').innerHTML = `
      <div class="text-center" style="padding:3rem 0; color:hsl(var(--muted-foreground));">
        <div class="spinner" style="margin-bottom:1rem;"></div>
        <div style="font-size:0.85rem;">Loading order details…</div>
      </div>`;
    openModal('orderModal');
  }

  try {
    const res  = await apiFetch(`${API}/orders/${orderId}`);
    const data = await res.json();
    if (!data.success) throw new Error(data.error || 'Failed to load order');

    renderOrderModal(data.order, data.items || []);
  } catch (err) {
    console.error('[openOrder]', err);
    document.getElementById('orderModalBody').innerHTML = `
      <div class="empty-state">
        <svg xmlns="http://www.w3.org/2000/svg" width="48" height="48" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><circle cx="12" cy="12" r="10"/><line x1="12" x2="12" y1="8" y2="12"/><line x1="12" x2="12.01" y1="16" y2="16"/></svg>
        <h5>Failed to load order</h5>
        <p>${escHtml(err.message)}</p>
      </div>`;
  }
}

async function loadReassignCandidates(selectId, excludeDriverId) {
  const sel = document.getElementById(selectId);
  if (!sel) return;
  sel.innerHTML = '<option value="">Loading available drivers…</option>';
  try {
    const res = await apiFetch(`${API}/drivers/reassign-candidates`);
    const data = await res.json();
    const list = (data.drivers || []).filter((d) => String(d.id) !== String(excludeDriverId || ''));
    if (!list.length) {
      sel.innerHTML = '<option value="">No other approved active drivers found</option>';
      return;
    }
    sel.innerHTML = '<option value="">— Select specific driver —</option>' + list.map((d) => {
      const avail = d.is_available && d.current_status === 'available' && Number(d.active_orders_count || 0) === 0;
      const busy = Number(d.active_orders_count || 0) > 0;
      const tag = avail ? '🟢 Available' : (busy ? '🔴 Busy (On delivery)' : `⚪ ${d.current_status || 'Offline'}`);
      const veh = d.vehicle_registration ? ` · ${d.vehicle_registration}` : '';
      return `<option value="${escHtml(d.id)}" ${busy ? 'disabled' : ''}>${escHtml(`${d.first_name || ''} ${d.last_name || ''}`.trim())} (${tag}${veh})</option>`;
    }).join('');
  } catch (err) {
    sel.innerHTML = `<option value="">Failed to load drivers</option>`;
  }
}

async function adminReassignToQueue(orderId, btn) {
  const reason = document.getElementById('dispatchReassignReason')?.value?.trim() || '';
  const offline = Boolean(document.getElementById('dispatchOldDriverOffline')?.checked);
  if (!confirm('Unassign the current driver and return this order to available online drivers? The restaurant and customer will be updated live.')) return;
  if (btn) btn.disabled = true;
  try {
    const res = await fetch(`${API}/orders/${orderId}/reassign-driver`, {
      method: 'POST',
      headers: { 'Content-Type': 'application/json' },
      credentials: 'same-origin',
      body: JSON.stringify({ mode: 'queue', reason, old_driver_action: offline ? 'offline' : 'available' }),
    });
    const data = await res.json();
    if (!res.ok || !data.success) throw new Error(data.error || 'Failed to reassign');
    showToast('Reassigned to Queue', data.message, 'success');
    loadOrders(currentPage, true);
    loadStats();
    openOrder(orderId, true);
  } catch (err) {
    showToast('Reassign Blocked', err.message, 'danger');
    if (btn) btn.disabled = false;
  }
}

async function adminReassignDirect(orderId, btn) {
  const newDriverId = document.getElementById('dispatchDirectDriverSelect')?.value || '';
  const reason = document.getElementById('dispatchReassignReason')?.value?.trim() || '';
  const offline = Boolean(document.getElementById('dispatchOldDriverOffline')?.checked);
  if (!newDriverId) {
    showToast('Select Driver', 'Please choose an available driver to direct-assign.', 'warning');
    return;
  }
  if (btn) btn.disabled = true;
  try {
    const res = await fetch(`${API}/orders/${orderId}/reassign-driver`, {
      method: 'POST',
      headers: { 'Content-Type': 'application/json' },
      credentials: 'same-origin',
      body: JSON.stringify({ mode: 'direct', new_driver_id: newDriverId, reason, old_driver_action: offline ? 'offline' : 'available' }),
    });
    const data = await res.json();
    if (!res.ok || !data.success) throw new Error(data.error || 'Failed to direct-assign');
    showToast('Driver Reassigned', data.message, 'success');
    loadOrders(currentPage, true);
    loadStats();
    openOrder(orderId, true);
  } catch (err) {
    showToast('Reassign Error', err.message, 'danger');
    if (btn) btn.disabled = false;
  }
}

async function adminDispatchRescue(orderId, rescueMode, btn) {
  const notes = document.getElementById('rescueNotes')?.value?.trim() || '';
  const offline = Boolean(document.getElementById('rescueOldDriverOffline')?.checked ?? true);
  const payload = {
    rescue_mode: rescueMode,
    notes,
    old_driver_action: offline ? 'offline' : 'available',
  };
  if (rescueMode === 'special_driver') {
    payload.courier_name = document.getElementById('rescueCourierName')?.value?.trim() || '';
    payload.courier_phone = document.getElementById('rescueCourierPhone')?.value?.trim() || '';
    payload.courier_vehicle = document.getElementById('rescueCourierVehicle')?.value?.trim() || '';
    payload.courier_plate = document.getElementById('rescueCourierPlate')?.value?.trim() || '';
    if (!payload.courier_name || !payload.courier_phone) {
      showToast('Missing Courier Info', 'Please enter name and phone number for the special driver.', 'warning');
      return;
    }
  }
  if (btn) btn.disabled = true;
  try {
    const res = await fetch(`${API}/orders/${orderId}/rescue-dispatch`, {
      method: 'POST',
      headers: { 'Content-Type': 'application/json' },
      credentials: 'same-origin',
      body: JSON.stringify(payload),
    });
    const data = await res.json();
    if (!res.ok || !data.success) throw new Error(data.error || 'Failed to assign rescue courier');
    showToast('Rescue Dispatched', data.message, 'success');
    loadOrders(currentPage, true);
    openOrder(orderId, true);
  } catch (err) {
    showToast('Rescue Error', err.message, 'danger');
    if (btn) btn.disabled = false;
  }
}

async function adminCompleteRescue(orderId, bypassCode, btn) {
  const verificationCode = document.getElementById('rescueVerifyCode')?.value?.trim() || '';
  if (!bypassCode && !verificationCode) {
    showToast('Code Needed', 'Enter customer verification code or click Confirm Delivered (Override).', 'warning');
    return;
  }
  if (bypassCode && !confirm('Confirm this rescued order has been handed to the customer? Original driver will NOT be credited.')) return;
  if (btn) btn.disabled = true;
  try {
    const res = await fetch(`${API}/orders/${orderId}/rescue-complete`, {
      method: 'POST',
      headers: { 'Content-Type': 'application/json' },
      credentials: 'same-origin',
      body: JSON.stringify({ verification_code: verificationCode, bypass_code: Boolean(bypassCode) }),
    });
    const data = await res.json();
    if (!res.ok || !data.success) throw new Error(data.error || 'Failed to complete delivery');
    showToast('Delivered', data.message, 'success');
    loadOrders(currentPage, true);
    loadStats();
    openOrder(orderId, true);
  } catch (err) {
    showToast('Verification Error', err.message, 'danger');
    if (btn) btn.disabled = false;
  }
}

async function adminCancelAndRefund(orderId, btn) {
  const reason = document.getElementById('adminCancelReason')?.value?.trim() || '';
  if (!reason) {
    showToast('Reason Required', 'Please enter why this order is being cancelled and refunded.', 'warning');
    return;
  }
  if (!confirm(`Cancel this order AND issue a refund to the customer?\nReason: ${reason}`)) return;
  if (btn) btn.disabled = true;
  try {
    const res = await fetch(`${API}/orders/${orderId}/cancel-refund`, {
      method: 'POST',
      headers: { 'Content-Type': 'application/json' },
      credentials: 'same-origin',
      body: JSON.stringify({ reason }),
    });
    const data = await res.json();
    if (!res.ok || !data.success) throw new Error(data.error || 'Failed to cancel & refund');
    showToast('Cancelled & Refunded', data.message, data.refundError ? 'warning' : 'success');
    loadOrders(currentPage, true);
    loadStats();
    openOrder(orderId, true);
  } catch (err) {
    showToast('Cancel/Refund Error', err.message, 'danger');
    if (btn) btn.disabled = false;
  }
}

async function adminFailCustomerForfeit(orderId, btn) {
  const reason = document.getElementById('failForfeitReason')?.value?.trim() || 'Customer unreachable after driver arrived — order failed and payment forfeited';
  if (!confirm(`FAIL ORDER (CUSTOMER FORFEITS MONEY)?\n\n• Customer will NOT be refunded.\n• Driver WILL be paid and freed.\n• Order status becomes Delivery Failed.\n\nReason: ${reason}`)) return;
  if (btn) btn.disabled = true;
  try {
    const res = await fetch(`${API}/orders/${orderId}/fail-forfeit`, {
      method: 'POST',
      headers: { 'Content-Type': 'application/json' },
      credentials: 'same-origin',
      body: JSON.stringify({ reason }),
    });
    const data = await res.json();
    if (!res.ok || !data.success) throw new Error(data.error || 'Failed to mark delivery failed');
    showToast('Order Failed (Forfeited)', data.message, 'warning');
    loadOrders(currentPage, true);
    loadStats();
    openOrder(orderId, true);
  } catch (err) {
    showToast('Fail Order Error', err.message, 'danger');
    if (btn) btn.disabled = false;
  }
}

function buildHappyDispatchHtml(order) {
  const terminal = ['delivered', 'cancelled', 'no_drivers_available', 'delivery_failed'].includes(order.status);
  const rescue = typeof order.rescue_courier === 'string'
    ? (() => { try { return JSON.parse(order.rescue_courier); } catch { return null; } })()
    : order.rescue_courier;

  const callPills = [
    order.customer_phone ? `<a class="od-call-pill primary" href="tel:${escHtml(order.customer_phone)}">📞 Call Customer (${escHtml(order.customer_phone)})</a>` : '',
    (rescue?.phone || order.driver_phone) ? `<a class="od-call-pill primary" href="tel:${escHtml(rescue?.phone || order.driver_phone)}">📞 Call ${rescue ? 'Rescue Courier' : 'Driver'} (${escHtml(rescue?.phone || order.driver_phone)})</a>` : '',
    order.restaurant_phone ? `<a class="od-call-pill" href="tel:${escHtml(order.restaurant_phone)}">📞 Call Restaurant (${escHtml(order.restaurant_phone)})</a>` : '',
  ].filter(Boolean).join('');

  if (terminal) {
    return callPills
      ? `<div class="od-dispatch-panel"><div class="od-dispatch-header"><strong>📞 Quick Contacts</strong></div><div class="od-call-strip">${callPills}</div></div>`
      : '';
  }

  const canPrePickupReassign = ['accepted_by_driver', 'order_ready'].includes(order.status) && !order.picked_up_at && Boolean(order.driver_id);
  const isPostPickup = ['picked_up', 'on_the_way', 'arrived'].includes(order.status);

  let bodyHtml = '';

  if (canPrePickupReassign) {
    bodyHtml += `
      <div class="od-dispatch-section">
        <div style="font-weight:700;font-size:0.86rem;color:#1e40af;">🔄 Reassign Driver (Allowed Before Pickup Only)</div>
        <div style="font-size:0.78rem;color:hsl(var(--muted-foreground));">Driver has not collected the food yet. Reassigning immediately updates the restaurant and customer with the new driver details.</div>
        <input type="text" id="dispatchReassignReason" placeholder="Reason (e.g. Driver bike breakdown / running late)" style="padding:0.45rem 0.65rem;border:1px solid hsl(var(--border));border-radius:6px;font-size:0.82rem;">
        <label style="display:flex;align-items:center;gap:0.4rem;font-size:0.78rem;cursor:pointer;">
          <input type="checkbox" id="dispatchOldDriverOffline"> Set previous driver offline (emergency / unable to work)
        </label>
        <div style="display:flex;flex-wrap:wrap;gap:0.5rem;align-items:center;">
          <button class="btn btn-outline btn-sm" onclick="adminReassignToQueue('${order.id}', this)">Re-open to Available Drivers Queue</button>
          <select id="dispatchDirectDriverSelect" style="flex:1;min-width:210px;padding:0.42rem 0.6rem;border:1px solid hsl(var(--border));border-radius:6px;font-size:0.82rem;">
            <option value="">Loading available drivers…</option>
          </select>
          <button class="btn btn-primary btn-sm" onclick="adminReassignDirect('${order.id}', this)">Assign Selected Driver</button>
        </div>
      </div>`;
  }

  if (isPostPickup) {
    bodyHtml += `
      <div class="od-dispatch-section" style="border-color:#a7f3d0;background:#f0fdf4;">
        <div style="font-weight:700;font-size:0.86rem;color:#065f46;">🛡️ Post-Pickup Rescue Delivery (Order Already Collected — Public Queue Reassign Locked)</div>
        <div style="font-size:0.78rem;color:#047857;">If the driver had an accident or cannot finish delivering after pickup, Happy can take over personally OR call a trusted special driver (Happy pays them directly; failed app driver is NOT paid).</div>
        <input type="text" id="rescueNotes" placeholder="Emergency / handoff note (visible in audit trail)" style="padding:0.45rem 0.65rem;border:1px solid #a7f3d0;border-radius:6px;font-size:0.82rem;">
        <label style="display:flex;align-items:center;gap:0.4rem;font-size:0.78rem;cursor:pointer;">
          <input type="checkbox" id="rescueOldDriverOffline" checked> Take incapacitated driver offline
        </label>
        <div style="display:flex;gap:0.5rem;flex-wrap:wrap;align-items:center;">
          <button class="btn btn-success btn-sm" onclick="adminDispatchRescue('${order.id}', 'admin_self', this)">🚗 Happy Will Fetch &amp; Deliver Himself</button>
        </div>
        <div style="border-top:1px dashed #a7f3d0;padding-top:0.55rem;margin-top:0.15rem;">
          <div style="font-size:0.78rem;font-weight:700;color:#065f46;margin-bottom:0.35rem;">Or Dispatch Trusted Special Driver (Paid by Happy Himself):</div>
          <div style="display:grid;grid-template-columns:repeat(auto-fit,minmax(140px,1fr));gap:0.4rem;margin-bottom:0.45rem;">
            <input type="text" id="rescueCourierName" value="${escHtml(rescue?.mode === 'special_driver' ? rescue.name : '')}" placeholder="Special driver name *" style="padding:0.4rem 0.55rem;border:1px solid #a7f3d0;border-radius:6px;font-size:0.8rem;">
            <input type="tel" id="rescueCourierPhone" value="${escHtml(rescue?.mode === 'special_driver' ? rescue.phone : '')}" placeholder="Phone number *" style="padding:0.4rem 0.55rem;border:1px solid #a7f3d0;border-radius:6px;font-size:0.8rem;">
            <input type="text" id="rescueCourierVehicle" value="${escHtml(rescue?.mode === 'special_driver' ? (rescue.vehicle || '') : '')}" placeholder="Vehicle (optional)" style="padding:0.4rem 0.55rem;border:1px solid #a7f3d0;border-radius:6px;font-size:0.8rem;">
            <input type="text" id="rescueCourierPlate" value="${escHtml(rescue?.mode === 'special_driver' ? (rescue.plate || '') : '')}" placeholder="Reg / plate (optional)" style="padding:0.4rem 0.55rem;border:1px solid #a7f3d0;border-radius:6px;font-size:0.8rem;">
          </div>
          <button class="btn btn-primary btn-sm" onclick="adminDispatchRescue('${order.id}', 'special_driver', this)">Assign Trusted Special Driver</button>
        </div>
        ${rescue ? `
          <div style="border-top:1px solid #6ee7b7;padding-top:0.55rem;margin-top:0.2rem;display:flex;flex-wrap:wrap;gap:0.45rem;align-items:center;">
            <input type="text" id="rescueVerifyCode" placeholder="Customer 6-char code" style="width:165px;padding:0.4rem 0.55rem;border:1px solid #6ee7b7;border-radius:6px;font-size:0.82rem;text-transform:uppercase;">
            <button class="btn btn-success btn-sm" onclick="adminCompleteRescue('${order.id}', false, this)">Verify Code &amp; Complete</button>
            <button class="btn btn-outline btn-sm" onclick="adminCompleteRescue('${order.id}', true, this)">Confirm Delivered (Admin Override)</button>
          </div>` : ''}
      </div>

      <div class="od-dispatch-section" style="border-color:#fecaca;background:#fef2f2;">
        <div style="font-weight:700;font-size:0.86rem;color:#991b1b;">⛔ Customer Unreachable After Arrival — Fail Order (Customer Forfeits Money)</div>
        <div style="font-size:0.78rem;color:#b91c1c;">Use this if the driver arrived and neither the driver nor Happy can reach the customer. <strong>No refund</strong> is sent to customer, and the driver IS credited for delivering.</div>
        <div style="display:flex;gap:0.45rem;flex-wrap:wrap;align-items:center;">
          <input type="text" id="failForfeitReason" value="Customer did not answer calls/door after arrival — payment forfeited" style="flex:1;min-width:200px;padding:0.42rem 0.6rem;border:1px solid #fca5a5;border-radius:6px;font-size:0.8rem;">
          <button class="btn btn-danger btn-sm" onclick="adminFailCustomerForfeit('${order.id}', this)">Fail Order &amp; Forfeit Customer Payment</button>
        </div>
      </div>`;
  }

  bodyHtml += `
    <div class="od-dispatch-section">
      <div style="font-weight:700;font-size:0.84rem;color:#475569;">💸 Cancel Whole Order &amp; Refund Customer</div>
      <div style="display:flex;gap:0.45rem;flex-wrap:wrap;align-items:center;">
        <input type="text" id="adminCancelReason" placeholder="Reason for cancelling & refunding customer…" style="flex:1;min-width:200px;padding:0.42rem 0.6rem;border:1px solid hsl(var(--border));border-radius:6px;font-size:0.8rem;">
        <button class="btn btn-outline btn-sm" style="color:#dc2626;border-color:#fca5a5;" onclick="adminCancelAndRefund('${order.id}', this)">Cancel Order &amp; Refund Customer</button>
      </div>
    </div>`;

  return `
    <div class="od-dispatch-panel">
      <div class="od-dispatch-header">
        <strong style="font-size:0.88rem;">🛡️ Happy Dispatch Controls</strong>
        <div class="od-call-strip">${callPills}</div>
      </div>
      ${bodyHtml}
    </div>`;
}

function renderOrderModal(order, items) {
  document.getElementById('orderModalLabel').textContent =
    `Order #${escHtml(order.order_number || order.id.slice(0,8).toUpperCase())}`;

  const statusClass = STATUS_BADGES[order.status] || 'badge-gray';
  const payClass    = PAY_BADGES[order.payment_status] || 'badge-yellow';
  const pendingBanner = order.status === 'pending'
    ? `<div style="display:flex; align-items:center; justify-content:space-between; background:hsl(var(--muted)); padding:1rem; border-radius:var(--radius); border:1px solid hsl(var(--border)); gap:0.75rem; flex-wrap:wrap;">
         <div>
           <div style="font-weight:600; font-size:0.9rem;">Action Required: Approve or Reject Order</div>
           <div style="font-size:0.8rem; color:hsl(var(--muted-foreground));">Accepting allows the customer to pay. Once paid, active drivers will be notified.</div>
         </div>
         <div style="display:flex; gap:0.5rem;">
           <button class="btn btn-success btn-sm" onclick="acceptOrder('${order.id}', this)">Accept Order</button>
           <button class="btn btn-danger btn-sm" onclick="rejectOrder('${order.id}', this)">Reject Order</button>
         </div>
       </div>`
    : '';

  const dispatchBanner = buildHappyDispatchHtml(order);
  const combinedBanner = [pendingBanner, dispatchBanner].filter(Boolean).join('');

  document.getElementById('orderModalBody').innerHTML = OrderDetails.renderOrderDetailContent(order, items || [], {
    apiBase: API,
    showRestaurant: true,
    showSupportCall: false,
    supportPhone: window.SUPPORT_PHONE || '',
    statusText: fmtStatus(order.status, order.payment_status),
    statusBadgeClass: statusClass,
    paymentText: fmtPayStatus(order.payment_status),
    paymentBadgeClass: payClass,
    paymentMethodText: fmtPayMethod(order.payment_method),
    actionsBannerHtml: combinedBanner,
  });

  if (document.getElementById('dispatchDirectDriverSelect')) {
    loadReassignCandidates('dispatchDirectDriverSelect', order.driver_id);
  }
}

// ── Filters ───────────────────────────────────────────────────────────
function applyFilters() { loadOrders(1); }

function resetFilters() {
  document.getElementById('filterRestaurant').value = 'all';
  document.getElementById('filterStatus').value     = 'all';
  document.getElementById('filterDate').value       = '';
  loadOrders(1);
}

// ── UI helpers (Dashboard pattern) ───────────────────────────────────
function toggleDropdown(btn) {
  const dropdown = btn.closest('.dropdown');
  document.querySelectorAll('.dropdown').forEach(d => {
    if (d !== dropdown) d.classList.remove('active');
  });
  dropdown.classList.toggle('active');
}
document.addEventListener('click', (e) => {
  if (!e.target.closest('.dropdown')) {
    document.querySelectorAll('.dropdown').forEach(d => d.classList.remove('active'));
  }
});

function openModal(id) {
  document.getElementById(id).classList.add('active');
  document.body.style.overflow = 'hidden';
}
function closeModal(id) {
  document.getElementById(id).classList.remove('active');
  document.body.style.overflow = '';
  if (id === 'orderModal') window.currentOpenOrderId = null;
}

function showToast(title, description, type = 'info') {
  const container = document.getElementById('toastContainer');
  const toast = document.createElement('div');
  toast.className = 'toast';
  const borderColors = {
    info: 'hsl(var(--primary))',
    success: 'hsl(142.1 76.2% 36.3%)',
    danger: 'hsl(var(--destructive))',
    warning: '#b45309'
  };
  toast.style.borderLeft = `4px solid ${borderColors[type] || borderColors.info}`;
  toast.innerHTML = `
    <div class="toast-title">${escHtml(title)}</div>
    <div class="toast-description">${escHtml(description)}</div>
  `;
  container.appendChild(toast);
  setTimeout(() => toast.classList.add('show'), 10);
  setTimeout(() => {
    toast.classList.remove('show');
    setTimeout(() => toast.remove(), 300);
  }, 4000);
}

// ── Data helpers ──────────────────────────────────────────────────────
async function apiFetch(url) {
  const res = await fetch(url, { credentials: 'same-origin' });
  if (res.status === 401) { window.location.href = '/manager/login'; }
  return res;
}

function setText(id, val) {
  const el = document.getElementById(id);
  if (el) el.textContent = val;
}

function escHtml(str) {
  return String(str ?? '').replace(/&/g,'&amp;').replace(/</g,'&lt;').replace(/>/g,'&gt;').replace(/"/g,'&quot;');
}

function todayISO() {
  return new Date().toISOString().split('T')[0];
}

function fmtMoney(val) {
  return parseFloat(val || 0).toFixed(2).replace(/\B(?=(\d{3})+(?!\d))/g, ',');
}

function fmtNumber(val) {
  return parseFloat(val || 0).toFixed(2).replace(/\B(?=(\d{3})+(?!\d))/g, ',');
}

function fmtTime(iso) {
  if (!iso) return '—';
  return new Date(iso).toLocaleTimeString('en-ZA', { hour:'2-digit', minute:'2-digit' });
}

function fmtDateTime(iso) {
  if (!iso) return '—';
  return new Date(iso).toLocaleString('en-ZA', {
    day:'2-digit', month:'short', year:'numeric', hour:'2-digit', minute:'2-digit'
  });
}

function relativeTime(iso) {
  if (!iso) return '';
  const diff = Date.now() - new Date(iso).getTime();
  const m = Math.floor(diff / 60000);
  if (m < 1)   return 'just now';
  if (m < 60)  return `${m}m ago`;
  const h = Math.floor(m / 60);
  if (h < 24)  return `${h}h ago`;
  return `${Math.floor(h/24)}d ago`;
}

const STATUS_LABELS = {
  pending:                'Pending Approval',
  accepted_by_driver:     'Driver Assigned',
  ordering_at_restaurant: 'Accepted (Awaiting Payment)',
  order_ready:            'Order Ready',
  picked_up:              'Picked Up',
  on_the_way:             'On the Way',
  arrived:                'Arrived',
  delivered:              'Delivered',
  cancelled:              'Rejected / Cancelled',
  no_drivers_available:   'No Drivers',
  delivery_failed:        'Failed (Forfeited)',
};
function fmtStatus(s, paymentStatus) {
  if (s === 'ordering_at_restaurant') {
    return paymentStatus === 'completed' ? 'Paid (Finding Driver)' : 'Accepted (Awaiting Payment)';
  }
  return STATUS_LABELS[s] || String(s || '').replace(/_/g,' ');
}

const PAY_LABELS = { pending:'Pending', processing:'Processing', completed:'Paid', failed:'Failed', refunded:'Refunded' };
function fmtPayStatus(s) { return PAY_LABELS[s] || (s || 'Unknown'); }

const PAY_METHODS = { card:'Card', mobile_money:'Mobile Money', cash:'Cash' };
function fmtPayMethod(m) { return PAY_METHODS[m] || (m || 'Unknown'); }

function parseAddress(raw) {
  if (!raw) return 'No address provided';
  try {
    const obj = typeof raw === 'string' ? JSON.parse(raw) : raw;
    if (typeof obj === 'string') return escHtml(obj);
    const parts = [
      obj.street || obj.address_line1 || obj.line1,
      obj.suburb || obj.address_line2 || obj.line2,
      obj.city,
      obj.province || obj.state,
      obj.postal_code || obj.zip,
    ].filter(Boolean);
    return parts.length ? escHtml(parts.join(', ')) : escHtml(JSON.stringify(obj));
  } catch {
    return escHtml(String(raw));
  }
}

