        <li>
          <a href="/manager/settings" class="sidebar-menu-item">
            <svg xmlns="http://www.w3.org/2000/svg" width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M12.22 2h-.44a2 2 0 0 0-2 2v.18a2 2 0 0 1-1 1.73l-.43.25a2 2 0 0 1-2 0l-.15-.08a2 2 0 0 0-2.73.73l-.22.38a2 2 0 0 0 .73 2.73l.15.1a2 2 0 0 1 1 1.72v.51a2 2 0 0 1-1 1.74l-.15.09a2 2 0 0 0-.73 2.73l.22.38a2 2 0 0 0 2.73.73l.15-.08a2 2 0 0 1 2 0l.43.25a2 2 0 0 1 1 1.73V20a2 2 0 0 0 2 2h.44a2 2 0 0 0 2-2v-.18a2 2 0 0 1 1-1.73l.43-.25a2 2 0 0 1 2 0l.15.08a2 2 0 0 0 2.73-.73l.22-.39a2 2 0 0 0-.73-2.73l-.15-.08a2 2 0 0 1-1-1.74v-.5a2 2 0 0 1 1-1.74l.15-.09a2 2 0 0 0 .73-2.73l-.22-.38a2 2 0 0 0-2.73-.73l-.15.08a2 2 0 0 1-2 0l-.43-.25a2 2 0 0 1-1-1.73V4a2 2 0 0 0-2-2z"/><circle cx="12" cy="12" r="3"/></svg>
            <span>Settings</span>
          </a>
        </li>
        <!-- <li style="margin-top:auto;">
          <a href="/manager/logout" class="sidebar-menu-item" style="color:hsl(var(--destructive));">
            <svg xmlns="http://www.w3.org/2000/svg" width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M9 21H5a2 2 0 0 1-2-2V5a2 2 0 0 1 2-2h4"/><polyline points="16 17 21 12 16 7"/><line x1="21" x2="9" y1="12" y2="12"/></svg>
            <span>Logout</span>
          </a>
        </li> -->
      </ul>
    </nav>
    <div class="sidebar-footer">
      <div class="sidebar-user">
        <div class="avatar"><%= manager.first_name ? manager.first_name[0] : 'M' %><%= manager.last_name ? manager.last_name[0] : '' %></div>
        <div class="sidebar-user-info">
          <span class="sidebar-user-name"><%= manager.first_name || 'Manager' %> <%= manager.last_name || '' %></span>
          <span class="sidebar-user-role">Restaurant Manager</span>
        </div>
      </div>
    </div>
  </aside>

  <!-- ═══════════════════════ MAIN CONTENT ═══════════════════════ -->
  <main class="main-content">
    <!-- Topbar -->
    <div class="topbar">
      <div class="topbar-search">
        <div class="search-input-wrapper">
          <svg xmlns="http://www.w3.org/2000/svg" width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><circle cx="11" cy="11" r="8"/><path d="m21 21-4.3-4.3"/></svg>
          <input type="text" class="search-input" placeholder="Search orders, restaurants...">
        </div>
      </div>
      <div class="topbar-actions">
        <div class="dropdown">
          <button class="btn btn-ghost btn-icon notification-btn" onclick="toggleDropdown(this)">
            <svg xmlns="http://www.w3.org/2000/svg" width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M6 8a6 6 0 0 1 12 0c0 7 3 9 3 9H3s3-2 3-9"/><path d="M10.3 21a1.94 1.94 0 0 0 3.4 0"/></svg>
            <span class="notification-badge" id="topbarBadge" style="display:none">0</span>
          </button>
          <div class="dropdown-content" style="width: 20rem;">
            <div class="dropdown-label">Notifications</div>
            <div class="dropdown-separator"></div>
            <div class="dropdown-item" style="flex-direction: column; align-items: flex-start;">
              <span class="font-medium">Live Updates Enabled</span>
              <span class="text-muted" style="font-size: 0.75rem;">Orders refresh automatically every 20s</span>
            </div>
          </div>
        </div>
        <div class="dropdown">
          <button class="btn btn-ghost btn-icon" onclick="toggleDropdown(this)" style="border-radius: 50%;">
            <div class="avatar"><%= manager.first_name ? manager.first_name[0] : 'M' %></div>
          </button>
          <div class="dropdown-content">
            <div class="dropdown-label">My Account</div>
            <div class="dropdown-separator"></div>
            <a href="/manager/settings" class="dropdown-item">Settings</a>
            <div class="dropdown-separator"></div>
            <a href="/manager/logout" class="dropdown-item danger">Log out</a>
          </div>
        </div>
      </div>
    </div>

    <!-- Page Content -->
    <div class="page-container">
      <!-- Header -->
      <div class="page-header">
        <div>
          <h2 class="page-title">Order Management</h2>
          <p style="color:hsl(var(--muted-foreground)); margin-top:4px; font-size:0.9rem;">Monitor and manage all incoming orders in real time</p>
        </div>
        <div class="page-actions">
          <span class="live-badge">
            <span class="live-dot"></span>
            Live updates
          </span>
          <button class="btn btn-outline btn-sm" onclick="loadOrders(currentPage)">
            <svg id="refreshIcon" xmlns="http://www.w3.org/2000/svg" width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M21 12a9 9 0 0 0-9-9 9.75 9.75 0 0 0-6.74 2.74L3 8"/><path d="M3 3v5h5"/><path d="M3 12a9 9 0 0 0 9 9 9.75 9.75 0 0 0 6.74-2.74L21 16"/><path d="M16 16h5v5"/></svg>
            Refresh
          </button>
        </div>
      </div>

      <!-- Stats -->
      <div class="grid grid-4">
        <div class="card stat-card">
          <div class="card-header">
            <span class="card-title">Active Orders</span>
            <div class="stat-icon" style="color:hsl(var(--destructive));">
              <svg xmlns="http://www.w3.org/2000/svg" width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M8.56 2.9A7 7 0 0 1 19 9v4m-2 4H2a3 3 0 0 0 3-3V9a7 7 0 0 1 7-7h9a3 3 0 0 1 3 3v9a7 7 0 0 1-7 7h-1"/><path d="M12 2v2"/><path d="M12 20v2"/><path d="m4.93 4.93 1.41 1.41"/><path d="m17.66 17.66 1.41 1.41"/><path d="M2 12h2"/><path d="M20 12h2"/><path d="m6.34 17.66-1.41 1.41"/><path d="m19.07 4.93-1.41 1.41"/></svg>
            </div>
          </div>
          <div class="card-content">
            <div class="stat-value" id="statActive">—</div>
            <p class="stat-description">Currently in progress</p>
          </div>
        </div>
        <div class="card stat-card">
          <div class="card-header">
            <span class="card-title">Pending</span>
            <div class="stat-icon" style="color:#b45309;">
              <svg xmlns="http://www.w3.org/2000/svg" width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><circle cx="12" cy="12" r="10"/><polyline points="12 6 12 12 16 14"/></svg>
            </div>
          </div>
          <div class="card-content">
            <div class="stat-value" id="statPending">—</div>
            <p class="stat-description">Awaiting acceptance</p>
          </div>
        </div>
        <div class="card stat-card">
          <div class="card-header">
            <span class="card-title">Today's Revenue</span>
            <div class="stat-icon" style="color:hsl(142.1 76.2% 36.3%);">
              <!-- <svg xmlns="http://www.w3.org/2000/svg" width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><line x1="12" x2="12" y1="2" y2="22"/><path d="M17 5H9.5a3.5 3.5 0 0 0 0 7h5a3.5 3.5 0 0 1 0 7H6"/></svg> -->
               <svg xmlns="http://www.w3.org/2000/svg" width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" class="lucide lucide-credit-card-icon lucide-credit-card"><rect width="20" height="14" x="2" y="5" rx="2"/><line x1="2" x2="22" y1="10" y2="10"/></svg>
            </div>
          </div>
          <div class="card-content">
            <div class="stat-value">R<span id="statRevenue">—</span></div>
            <p class="stat-description">From delivered orders</p>
          </div>
        </div>
        <div class="card stat-card">
          <div class="card-header">
            <span class="card-title">Orders Today</span>
            <div class="stat-icon" style="color:hsl(var(--primary));">
              <svg xmlns="http://www.w3.org/2000/svg" width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M5 12h14"/><path d="M12 5v14"/></svg>
            </div>
          </div>
          <div class="card-content">
            <div class="stat-value" id="statTotal">—</div>
            <p class="stat-description">Total placed today</p>
          </div>
        </div>
      </div>

      <!-- Filters -->
      <div class="filters-card">
        <div class="filter-group">
          <label>Restaurant</label>
          <select id="filterRestaurant">
            <option value="all">All Restaurants</option>
            <% restaurants.forEach(r => { %>
              <option value="<%= r.id %>"><%= r.name %></option>
            <% }) %>
          </select>
        </div>
        <div class="filter-group">
          <label>Status</label>
          <select id="filterStatus">
            <option value="all">All Statuses</option>
            <option value="pending">Pending</option>
            <option value="accepted_by_driver">Accepted by Driver</option>
            <option value="ordering_at_restaurant">Ordering at Restaurant</option>
            <option value="order_ready">Ready for Pickup</option>
            <option value="picked_up">Picked Up</option>
            <option value="on_the_way">On the Way</option>
            <option value="arrived">Arrived</option>
            <option value="delivered">Delivered</option>
            <option value="cancelled">Cancelled</option>
            <option value="no_drivers_available">No Drivers</option>
          </select>
        </div>
        <div class="filter-group">
          <label>Date</label>
          <input type="date" id="filterDate">
        </div>
        <button class="btn btn-primary" onclick="applyFilters()">
          <svg xmlns="http://www.w3.org/2000/svg" width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><polygon points="22 3 2 3 10 12.46 10 19 14 21 14 12.46 22 3"/></svg>
          Apply
        </button>
        <button class="btn btn-outline" onclick="resetFilters()" title="Clear filters">
          <svg xmlns="http://www.w3.org/2000/svg" width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M18 6 6 18"/><path d="m6 6 12 12"/></svg>
        </button>
      </div>

      <!-- Table -->
      <div class="card">
        <div class="card-header card-header-row">
          <div>
            <h3 class="card-title">Orders</h3>
            <p class="card-description" id="tableMeta">Loading…</p>
          </div>
        </div>
        <div class="card-content card-content-full">
          <div class="table-wrapper">
            <table>
              <thead>
                <tr>
                  <th>Order #</th>
                  <th>Customer</th>
                  <th>Restaurant</th>
                  <th>Items</th>
                  <th>Total</th>
                  <th>Payment</th>
                  <th>Status</th>
                  <th>Placed</th>
                  <th style="width:50px;">Actions</th>
                </tr>
              </thead>
              <tbody id="ordersBody">
                <tr class="spinner-row">
                  <td colspan="9" class="text-center">
                    <div class="spinner"></div>
                    <div style="margin-top:0.5rem; color:hsl(var(--muted-foreground)); font-size:0.85rem;">Loading orders…</div>
                  </td>
                </tr>
              </tbody>
            </table>
          </div>
        </div>
        <!-- Pagination -->
        <div class="pagination-wrap">
          <span class="page-info" id="pageInfo"></span>
          <div class="pagination-buttons" id="pagination"></div>
        </div>
