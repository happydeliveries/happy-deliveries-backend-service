        </div>
      </div>
    </div>
  </aside>

  <!-- ═══════════════════════ MAIN CONTENT ═══════════════════════ -->
  <main class="main-content">
    <!-- Topbar -->
    <div class="topbar">
      <div class="topbar-search">
        <div class="search-input-wrapper">
          <svg xmlns="http://www.w3.org/2000/svg" width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><circle cx="11" cy="11" r="8"/><path d="m21 21-4.3-4.3"/></svg>
          <input type="text" class="search-input" placeholder="Search...">
        </div>
      </div>
      <div class="topbar-actions">
        <div class="dropdown">
          <button class="btn btn-ghost btn-icon" onclick="toggleDropdown(this)" style="border-radius:50%;">
            <div class="avatar"><%= manager.first_name ? manager.first_name[0] : 'M' %></div>
          </button>
          <div class="dropdown-content">
            <div class="dropdown-label">My Account</div>
            <div class="dropdown-separator"></div>
            <a href="/manager/settings" class="dropdown-item">Settings</a>
            <div class="dropdown-separator"></div>
            <a href="/manager/logout" class="dropdown-item danger">Log out</a>
          </div>
        </div>
      </div>
    </div>

    <!-- Settings Content -->
    <div class="page-container">
      <div style="margin-bottom: 1.5rem;">
        <h1 class="page-title">Settings</h1>
        <p class="text-muted">Manage your account settings and preferences</p>
      </div>

      <!-- Settings Tabs -->
      <div class="settings-tabs" style="margin-bottom: 1.5rem;">
        <button class="settings-tab active" data-settings="profile">
          <svg xmlns="http://www.w3.org/2000/svg" width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M19 21v-2a4 4 0 0 0-4-4H9a4 4 0 0 0-4 4v2"/><circle cx="12" cy="7" r="4"/></svg>
          Profile
        </button>
        <button class="settings-tab" data-settings="security">
          <svg xmlns="http://www.w3.org/2000/svg" width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M12 22s8-4 8-10V5l-8-3-8 3v7c0 6 8 10 8 10z"/></svg>
          Security
        </button>
        <button class="settings-tab" data-settings="notifications">
          <svg xmlns="http://www.w3.org/2000/svg" width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M6 8a6 6 0 0 1 12 0c0 7 3 9 3 9H3s3-2 3-9"/><path d="M10.3 21a1.94 1.94 0 0 0 3.4 0"/></svg>
          Notifications
        </button>
        <button class="settings-tab" data-settings="danger">
          <svg xmlns="http://www.w3.org/2000/svg" width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><circle cx="12" cy="12" r="10"/><line x1="15" x2="9" y1="9" y2="15"/><line x1="9" x2="15" y1="9" y2="15"/></svg>
          Danger Zone
        </button>
      </div>

      <!-- Profile Section -->
      <div class="settings-section active" id="settings-profile">
        <div class="card">
          <div class="card-header">
            <h3 class="card-title">Profile Information</h3>
            <p class="card-description">Update your personal information and profile settings</p>
          </div>
          <div class="card-content">
            <div style="display: flex; align-items: center; gap: 1.5rem; margin-bottom: 1.5rem;">
              <div class="avatar avatar-xl"><%= manager.first_name ? manager.first_name[0] : 'M' %><%= manager.last_name ? manager.last_name[0] : '' %></div>
              <div>
                <button class="btn btn-outline" onclick="showToast('Coming soon', 'Avatar upload will be available soon.')">Change Photo</button>
                <p class="text-muted" style="font-size: 0.875rem; margin-top: 0.5rem;">JPG, GIF or PNG. 1MB max.</p>
              </div>
            </div>
            <form id="profileForm" onsubmit="saveProfile(event)">
              <div class="form-row" style="margin-bottom: 1rem;">
                <div class="form-group">
                  <label class="form-label">First Name</label>
                  <input type="text" id="firstName" value="<%= manager.first_name || '' %>" required>
                </div>
                <div class="form-group">
                  <label class="form-label">Last Name</label>
                  <input type="text" id="lastName" value="<%= manager.last_name || '' %>" required>
                </div>
              </div>
              <div class="form-group" style="margin-bottom: 1rem;">
                <label class="form-label">Email</label>
                <input type="email" id="email" value="<%= manager.email || '' %>" required>
              </div>
              <div class="form-group" style="margin-bottom: 1.5rem;">
                <label class="form-label">Role</label>
                <input type="text" value="Restaurant Manager" disabled style="opacity:0.6; cursor:not-allowed;">
              </div>
              <button type="submit" class="btn btn-primary" id="profileBtn">Save Changes</button>
            </form>
          </div>
        </div>
      </div>

      <!-- Security Section -->
      <div class="settings-section" id="settings-security">
        <div class="card" style="margin-bottom: 1.5rem;">
          <div class="card-header">
            <h3 class="card-title">Change Password</h3>
            <p class="card-description">Update your password to keep your account secure</p>
          </div>
          <div class="card-content">
            <form id="passwordForm" onsubmit="changePassword(event)">
              <div class="form-group" style="margin-bottom: 1rem;">
                <label class="form-label">Current Password</label>
                <input type="password" id="currentPassword" required>
              </div>
              <div class="form-group" style="margin-bottom: 1rem;">
                <label class="form-label">New Password</label>
                <input type="password" id="newPassword" required minlength="8">
              </div>
              <div class="form-group" style="margin-bottom: 1.5rem;">
                <label class="form-label">Confirm New Password</label>
                <input type="password" id="confirmPassword" required minlength="8">
              </div>
              <button type="submit" class="btn btn-primary" id="passwordBtn">Update Password</button>
            </form>
          </div>
        </div>

        <div class="card">
          <div class="card-header">
            <h3 class="card-title">Active Sessions</h3>
            <p class="card-description">Manage your active sessions</p>
          </div>
          <div class="card-content">
            <div style="display: flex; align-items: center; justify-content: space-between; padding: 0.75rem; border: 1px solid hsl(var(--border)); border-radius: var(--radius); margin-bottom: 1rem;">
              <div>
                <div class="font-medium">Current Session</div>
                <div class="text-muted" style="font-size: 0.875rem;">This device</div>
              </div>
              <span class="badge badge-green">Active</span>
            </div>
            <button class="btn btn-outline btn-sm" onclick="showToast('Coming soon', 'Session management will be available soon.')">View All Sessions</button>
          </div>
        </div>
      </div>

      <!-- Notifications Section -->
      <div class="settings-section" id="settings-notifications">
        <div class="card">
          <div class="card-header">
            <h3 class="card-title">Notification Preferences</h3>
            <p class="card-description">Choose how you want to be notified about updates</p>
          </div>
          <div class="card-content">
            <h4 style="font-size: 0.875rem; font-weight: 500; margin-bottom: 1rem;">Order Updates</h4>
            <div class="switch-row">
              <div class="switch-info">
                <span class="switch-label">New Orders</span>
                <span class="switch-description">Receive notifications when new orders arrive</span>
              </div>
              <div class="switch active" onclick="toggleSwitch(this)" data-pref="new_orders"><div class="switch-thumb"></div></div>
            </div>
            <div class="switch-row">
              <div class="switch-info">
                <span class="switch-label">Order Status Changes</span>
                <span class="switch-description">Notifications when order status updates</span>
              </div>
              <div class="switch active" onclick="toggleSwitch(this)" data-pref="status_changes"><div class="switch-thumb"></div></div>
            </div>
            <div class="switch-row">
              <div class="switch-info">
                <span class="switch-label">Order Cancellations</span>
                <span class="switch-description">Alerts when orders are cancelled</span>
              </div>
              <div class="switch active" onclick="toggleSwitch(this)" data-pref="cancellations"><div class="switch-thumb"></div></div>
            </div>

            <h4 style="font-size: 0.875rem; font-weight: 500; margin: 1.5rem 0 1rem;">System</h4>
            <div class="switch-row">
              <div class="switch-info">
                <span class="switch-label">Email Notifications</span>
                <span class="switch-description">Receive summary emails</span>
              </div>
              <div class="switch" onclick="toggleSwitch(this)" data-pref="email_summary"><div class="switch-thumb"></div></div>
            </div>
            <div class="switch-row">
              <div class="switch-info">
                <span class="switch-label">Daily Reports</span>
                <span class="switch-description">End-of-day sales summary</span>
              </div>
              <div class="switch" onclick="toggleSwitch(this)" data-pref="daily_reports"><div class="switch-thumb"></div></div>
            </div>

            <button class="btn btn-primary" style="margin-top: 1rem;" onclick="saveNotificationPrefs()">Save Preferences</button>
          </div>
        </div>
      </div>

      <!-- Danger Zone Section -->
      <div class="settings-section" id="settings-danger">
        <div class="card" style="border-color: hsla(var(--destructive), 0.3);">
          <div class="card-header">
            <h3 class="card-title" style="color: hsl(var(--destructive));">Danger Zone</h3>
            <p class="card-description">Irreversible and destructive actions</p>
          </div>
          <div class="card-content">
            <div style="display: flex; align-items: center; justify-content: space-between; padding: 1rem; border: 1px solid hsla(var(--destructive), 0.2); border-radius: var(--radius); margin-bottom: 1rem;">
              <div>
                <div class="font-medium">Log Out All Devices</div>
                <div class="text-muted" style="font-size: 0.875rem;">Sign out from all other active sessions</div>
              </div>
              <button class="btn btn-outline" onclick="showToast('Coming soon', 'Session management will be available soon.')">Log Out All</button>
            </div>
            <div style="display: flex; align-items: center; justify-content: space-between; padding: 1rem; border: 1px solid hsla(var(--destructive), 0.2); border-radius: var(--radius);">
              <div>
                <div class="font-medium" style="color: hsl(var(--destructive));">Delete Account</div>
                <div class="text-muted" style="font-size: 0.875rem;">Permanently delete your account and all data</div>
              </div>
              <button class="btn btn-danger" onclick="showToast('Coming soon', 'Account deletion will be available soon.')">Delete Account</button>
            </div>
          </div>
        </div>
      </div>
    </div>
  </main>
</div>

<!-- Toast Container -->
<div class="toast-container" id="toastContainer"></div>
<script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.0/dist/js/bootstrap.bundle.min.js"></script>
<script src="/socket.io/socket.io.js"></script>
<script src="/js/manager.js"></script>
<script>
/* ═══════════════════════════════════════════════════════════════════════
   Happy Delivery — Settings Page (Dashboard-styled)
   API routes served by managerWeb.js:
     PUT /api/manager/settings/profile
     PUT /api/manager/settings/password
   ═══════════════════════════════════════════════════════════════════════ */

const API = '/manager/api';

// ── Tab switching ───────────────────────────────────────────────────────
document.querySelectorAll('.settings-tab').forEach(tab => {
  tab.addEventListener('click', () => {
    const settingsId = tab.dataset.settings;
    document.querySelectorAll('.settings-tab').forEach(t => t.classList.remove('active'));
    tab.classList.add('active');
    document.querySelectorAll('.settings-section').forEach(s => s.classList.remove('active'));
    document.getElementById('settings-' + settingsId).classList.add('active');
  });
});

// ── Dropdown ──────────────────────────────────────────────────────────
function toggleDropdown(btn) {
  const dropdown = btn.closest('.dropdown');
  document.querySelectorAll('.dropdown').forEach(d => {
    if (d !== dropdown) d.classList.remove('active');
  });
  dropdown.classList.toggle('active');
}
document.addEventListener('click', (e) => {
  if (!e.target.closest('.dropdown')) {
    document.querySelectorAll('.dropdown').forEach(d => d.classList.remove('active'));
  }
});

// ── Toast ─────────────────────────────────────────────────────────────
function showToast(title, description, type = 'info') {
  const container = document.getElementById('toastContainer');
  const toast = document.createElement('div');
  toast.className = 'toast';
  const borderColors = {
    info: 'hsl(var(--primary))',
    success: 'hsl(142.1 76.2% 36.3%)',
    danger: 'hsl(var(--destructive))',
    warning: '#b45309'
  };
  toast.style.borderLeft = `4px solid ${borderColors[type] || borderColors.info}`;
  toast.innerHTML = `
    <div class="toast-title">${escHtml(title)}</div>
    <div class="toast-description">${escHtml(description)}</div>
  `;
  container.appendChild(toast);
  setTimeout(() => toast.classList.add('show'), 10);
  setTimeout(() => {
    toast.classList.remove('show');
    setTimeout(() => toast.remove(), 300);
  }, 4000);
}

// ── Switch toggle ─────────────────────────────────────────────────────
function toggleSwitch(el) {
  el.classList.toggle('active');
}

// ── Save Profile ──────────────────────────────────────────────────────
async function saveProfile(e) {
  e.preventDefault();
  const btn = document.getElementById('profileBtn');
  btn.classList.add('btn-loading');

  const payload = {
    first_name: document.getElementById('firstName').value.trim(),
    last_name:  document.getElementById('lastName').value.trim(),
    email:      document.getElementById('email').value.trim().toLowerCase(),
  };

  try {
    const res = await fetch(`${API}/settings/profile`, {
      method: 'PUT',
      headers: { 'Content-Type': 'application/json' },
      credentials: 'same-origin',
      body: JSON.stringify(payload),
    });
    const data = await res.json();

    if (!res.ok || !data.success) {
      throw new Error(data.error || 'Failed to update profile');
    }

    // Update sidebar initials
    const initials = (payload.first_name[0] || 'M') + (payload.last_name[0] || '');
    document.querySelectorAll('.avatar').forEach(av => {
      if (!av.querySelector('img')) av.textContent = initials;
    });
    document.querySelectorAll('.sidebar-user-name').forEach(el => {
      el.textContent = `${payload.first_name} ${payload.last_name}`;
    });

    showToast('Profile updated', 'Your profile has been saved successfully.', 'success');
  } catch (err) {
    console.error('[saveProfile]', err);
    showToast('Error', err.message, 'danger');
  } finally {
    btn.classList.remove('btn-loading');
  }
}

// ── Change Password ─────────────────────────────────────────────────────
async function changePassword(e) {
  e.preventDefault();
  const btn = document.getElementById('passwordBtn');
  btn.classList.add('btn-loading');

  const current = document.getElementById('currentPassword').value;
  const newPass = document.getElementById('newPassword').value;
  const confirm = document.getElementById('confirmPassword').value;

  if (newPass !== confirm) {
    showToast('Error', 'New passwords do not match.', 'danger');
    btn.classList.remove('btn-loading');
    return;
  }
  if (newPass.length < 8) {
    showToast('Error', 'Password must be at least 8 characters.', 'danger');
    btn.classList.remove('btn-loading');
    return;
  }

  try {
    const res = await fetch(`${API}/settings/password`, {
      method: 'PUT',
      headers: { 'Content-Type': 'application/json' },
      credentials: 'same-origin',
      body: JSON.stringify({ current_password: current, new_password: newPass }),
    });
    const data = await res.json();

    if (!res.ok || !data.success) {
      throw new Error(data.error || 'Failed to update password');
    }

    document.getElementById('passwordForm').reset();
    showToast('Password updated', 'Your password has been changed successfully.', 'success');
  } catch (err) {
    console.error('[changePassword]', err);
    showToast('Error', err.message, 'danger');
  } finally {
    btn.classList.remove('btn-loading');
  }
}

// ── Save Notification Preferences ───────────────────────────────────────
function saveNotificationPrefs() {
  const prefs = {};
  document.querySelectorAll('.switch[data-pref]').forEach(sw => {
    prefs[sw.dataset.pref] = sw.classList.contains('active');
  });
  // Store locally for now; backend endpoint can be added later
  localStorage.setItem('hd_notification_prefs', JSON.stringify(prefs));
  showToast('Preferences saved', 'Your notification settings have been updated.', 'success');
}

// ── Load saved notification prefs ───────────────────────────────────────
document.addEventListener('DOMContentLoaded', () => {
  try {
    const saved = JSON.parse(localStorage.getItem('hd_notification_prefs') || '{}');
    Object.entries(saved).forEach(([key, val]) => {
      const sw = document.querySelector(`.switch[data-pref="${key}"]`);
      if (sw) sw.classList.toggle('active', val);
    });
  } catch (e) { /* ignore */ }
});

// ── Helpers ─────────────────────────────────────────────────────────────
function escHtml(str) {
  return String(str ?? '').replace(/&/g,'&amp;').replace(/</g,'&lt;').replace(/>/g,'&gt;').replace(/"/g,'&quot;');
}
</script>

</body>
</html>