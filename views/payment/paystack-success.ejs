<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title><%= title %></title>
  <style>
    * { box-sizing: border-box; margin: 0; padding: 0; }
    body {
      font-family: -apple-system, BlinkMacSystemFont, 'Segoe UI', Roboto, Helvetica, Arial, sans-serif;
      background: #0f172a;
      color: #0f172a;
      min-height: 100vh;
      display: flex;
      align-items: center;
      justify-content: center;
      padding: 20px;
    }
    .receipt-card {
      background: #ffffff;
      width: 100%;
      max-width: 440px;
      border-radius: 18px;
      padding: 32px 26px;
      text-align: center;
      box-shadow: 0 25px 60px rgba(0, 0, 0, 0.45);
    }
    .icon-circle {
      width: 68px;
      height: 68px;
      border-radius: 50%;
      margin: 0 auto 18px;
      display: flex;
      align-items: center;
      justify-content: center;
      font-size: 32px;
    }
    .icon-success { background: #dcfce7; color: #16a34a; }
    .icon-error { background: #fee2e2; color: #dc2626; }
    h1 {
      font-size: 22px;
      font-weight: 800;
      margin-bottom: 8px;
    }
    p.subtitle {
      font-size: 14px;
      color: #475569;
      margin-bottom: 22px;
      line-height: 1.5;
    }
    .meta-box {
      background: #f8fafc;
      border: 1px solid #e2e8f0;
      border-radius: 12px;
      padding: 14px 16px;
      text-align: left;
      font-size: 13px;
      margin-bottom: 22px;
    }
    .meta-row {
      display: flex;
      justify-content: space-between;
      padding: 6px 0;
      border-bottom: 1px solid #f1f5f9;
    }
    .meta-row:last-child { border-bottom: none; }
    .meta-lbl { color: #64748b; }
    .meta-val { font-weight: 700; color: #0f172a; }
    .btn {
      display: block;
      width: 100%;
      padding: 14px;
      border-radius: 12px;
      background: #09A5DB;
      color: #ffffff;
      font-weight: 800;
      font-size: 15px;
      text-decoration: none;
      border: none;
      cursor: pointer;
    }
  </style>
</head>
<body>
  <div class="receipt-card">
    <% if (success) { %>
      <div class="icon-circle icon-success">✓</div>
      <h1>Paystack Payment Confirmed!</h1>
      <p class="subtitle">
        Your payment for order <strong><%= order.order_number %></strong> was verified and your order is now live for nearby drivers to accept.
      </p>
      <div class="meta-box">
        <div class="meta-row">
          <span class="meta-lbl">Order Number</span>
          <span class="meta-val"><%= order.order_number %></span>
        </div>
        <div class="meta-row">
          <span class="meta-lbl">Amount Paid</span>
          <span class="meta-val"><%= currency %> <%= amount %></span>
        </div>
        <div class="meta-row">
          <span class="meta-lbl">Paystack Ref</span>
          <span class="meta-val"><%= reference %></span>
        </div>
        <div class="meta-row">
          <span class="meta-lbl">Status</span>
          <span class="meta-val" style="color:#16a34a;">Paid • Dispatched to Drivers</span>
        </div>
      </div>
      <button class="btn" onclick="window.close()">Return to Happy Delivery App</button>
    <% } else { %>
      <div class="icon-circle icon-error">✕</div>
      <h1>Payment Incomplete</h1>
      <p class="subtitle"><%= errorMessage || 'Your Paystack payment was not completed.' %></p>
      <button class="btn" onclick="window.close()">Return to App & Try Again</button>
    <% } %>
  </div>
</body>
</html>
